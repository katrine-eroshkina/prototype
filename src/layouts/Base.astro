---
import '../styles/global.css';
import HeaderA from '../components/global/HeaderA.astro';
import Footer from '../components/global/Footer.astro';
import SmoothScroll from '../components/global/SmoothScroll.astro';
import ToTop from '../components/global/ToTop.astro';
import LeadForms from '../components/global/LeadForms.astro';
import Breadcrumbs from '../components/wire/Breadcrumbs.astro';
import Block from '../blocks/Block.astro';
import { recipes, type RecipeKey } from '../data/recipes';
import type { Template } from '../data/sitemap';
import type { PageCtx } from '../data/content';

interface Props {
  title: string;
  /** Шаблон T1–T6 из docs/01 */
  template: Template;
  /** Схема блоков из recipes.ts */
  recipe?: RecipeKey;
  /** Контекст страницы для текстов блоков; по умолчанию собирается из title/crumbs */
  ctx?: Partial<PageCtx>;
  crumbs?: { href?: string; title: string }[];
  draft?: boolean;
  /** Страница сама рисует заголовок (например, статья блога) — без стандартной шапки с h1 */
  noTitle?: boolean;
}

const { title, template, recipe, crumbs, draft, noTitle } = Astro.props;
const ctx: PageCtx = { kind: recipe ?? 'system', title, crumbs, ...Astro.props.ctx } as PageCtx;
const blocks = recipe ? recipes[recipe] : [];
const hasHero = blocks.some((id) => id.startsWith('hero'));

const templateLabel: Record<Template, string> = {
  home: 'T1 · Главная',
  listing: 'T2 · Листинг',
  detail: 'T3 · Детальная',
  contacts: 'T4 · Контакты',
  text: 'T5 · Текстовая',
  system: 'T6 · Системная',
};
---
<!doctype html>
<html lang="ru" data-style="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>{title} — burkov/agency</title>
  </head>
  <body>
    <HeaderA />
    <SmoothScroll />
    <ToTop />
    <LeadForms />
    <main class="min-h-[50vh]">
      {!hasHero && !noTitle && (
        <div class="container-x py-10">
          {crumbs && <Breadcrumbs items={crumbs} />}
          <h1 class="mt-6 text-4xl font-semibold tracking-tight">{title}</h1>
        </div>
      )}
      {blocks.map((id, index) => <Block {id} {ctx} {index} />)}
      <div class="container-x"><slot /></div>
      <!-- Блоки после содержимого страницы — со своим контейнером (например, «Читайте также» и форма под статьёй) -->
      <slot name="after" />
    </main>
    <Footer />
  </body>
</html>
