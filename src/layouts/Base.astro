---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumbs from '../components/wire/Breadcrumbs.astro';
import Block from '../blocks/Block.astro';
import { recipes, type RecipeKey } from '../data/recipes';
import type { Template } from '../data/sitemap';
import type { PageCtx } from '../data/content';

interface Props {
  title: string;
  /** Шаблон T1–T6 из docs/01 */
  template: Template;
  /** Схема блоков из recipes.ts */
  recipe?: RecipeKey;
  /** Контекст страницы для текстов блоков; по умолчанию собирается из title/crumbs */
  ctx?: Partial<PageCtx>;
  crumbs?: { href?: string; title: string }[];
  draft?: boolean;
}

const { title, template, recipe, crumbs, draft } = Astro.props;
const ctx: PageCtx = { kind: recipe ?? 'system', title, crumbs, ...Astro.props.ctx } as PageCtx;
const blocks = recipe ? recipes[recipe] : [];
const hasHero = blocks.some((id) => id.startsWith('hero'));

const templateLabel: Record<Template, string> = {
  home: 'T1 · Главная',
  listing: 'T2 · Листинг',
  detail: 'T3 · Детальная',
  contacts: 'T4 · Контакты',
  text: 'T5 · Текстовая',
  system: 'T6 · Системная',
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <title>{title} — прототип</title>
  </head>
  <body>
    <Header />
    <div class="border-b bg-amber-50 font-mono text-[11px] text-muted-foreground">
      <div class="container-x flex gap-3 py-1.5">
        <span>{templateLabel[template]}{recipe && ` · схема «${recipe}»`}</span>
        {draft && <span class="text-draft">под вопросом</span>}
      </div>
    </div>
    <main class="min-h-[50vh]">
      {!hasHero && (
        <div class="container-x py-10">
          {crumbs && <Breadcrumbs items={crumbs} />}
          <h1 class="mt-6 text-4xl font-semibold tracking-tight">{title}</h1>
        </div>
      )}
      {blocks.map((id, index) => <Block {id} {ctx} {index} />)}
      <div class="container-x"><slot /></div>
    </main>
    <Footer />
  </body>
</html>
