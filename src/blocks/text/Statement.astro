---
/** text:statement — манифест: крупное высказывание + «чего мы не делаем» */
import Section, { type Theme } from '../Section.astro';
import { manifesto, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'dark' } = Astro.props;
---
<Section id="text" variant="statement" {theme}>
  <p class="max-w-4xl text-3xl font-semibold leading-tight tracking-tight text-balance md:text-5xl">{manifesto.title}</p>
  <ul class="mt-12 grid gap-4 border-t pt-8 text-muted-foreground sm:grid-cols-2 lg:grid-cols-4">
    {manifesto.not.map((n) => <li class="flex gap-2"><span aria-hidden="true">✕</span>{n}</li>)}
  </ul>
</Section>
