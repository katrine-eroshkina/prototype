---
/**
 * process — этапы работы.
 * Раскладка по Rulebase: четыре ячейки во всю ширину, в каждой — линейная схема
 * в цвете акцента, номер, название и пояснение.
 */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import ProcessArt from './ProcessArt.astro';
import { processSteps, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
const steps = processSteps(ctx);
---
<Section id="process" {theme} class="pb-0 md:pb-0">
  <SectionHead eyebrow="Процесс" title="Как работаем" lead="Четыре шага от первого созвона до отчёта в деньгах." />
  <ol class="grid border-t sm:grid-cols-2 lg:-mx-10 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="flex flex-col border-b bg-card/60 p-6 sm:border-r lg:border-b-0 lg:p-8 lg:last:border-r-0">
        <ProcessArt i={i} class="h-40 md:h-48" />
        <span class="mt-8 font-mono text-xs text-muted-foreground">0{i + 1}</span>
        <h3 class="mt-2 font-display text-2xl font-light tracking-tight">{s.t}</h3>
        <p class="mt-2 text-muted-foreground">{s.d}</p>
      </li>
    ))}
  </ol>
</Section>
