---
/** process — этапы: горизонтальная линия с номерами */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { processSteps, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
---
<Section id="process" {theme}>
  <SectionHead eyebrow="Процесс" title="Как работаем" />
  <ol class="grid gap-8 md:grid-cols-4">
    {processSteps(ctx).map((s, i) => (
      <li class="relative">
        <div class="flex items-center gap-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-full border bg-background font-semibold">{i + 1}</span>
          <span class="hidden h-px flex-1 bg-border md:block"></span>
        </div>
        <h3 class="mt-5 font-semibold">{s.t}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{s.d}</p>
      </li>
    ))}
  </ol>
</Section>
