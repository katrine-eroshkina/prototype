---
/** process:history — история компании по годам (как у Косатки и PR Partner) */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { history, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
---
<Section id="process" variant="history" {theme}>
  <SectionHead eyebrow="История" title="Как мы росли" />
  <ol class="grid gap-8 md:grid-cols-4">
    {history.map((h) => (
      <li class="border-t-2 border-foreground pt-5">
        <span class="text-3xl font-semibold tracking-tight">{h.y}</span>
        <h3 class="mt-3 font-semibold">{h.t}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{h.d}</p>
      </li>
    ))}
  </ol>
  <p class="mt-6 font-mono text-xs text-draft">годы и события — заглушки</p>
</Section>
