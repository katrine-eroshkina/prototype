---
/**
 * geography — города, где работаем. Блок главной, отдельного раздела нет.
 * Крупные строки городов слева, карта справа. Только реальные города (список ждём от заказчика).
 */
import Section, { type Theme } from '../Section.astro';
import Placeholder from '../Placeholder.astro';
import { regions } from '@/data/sitemap';
import type { PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
---
<Section id="geography" {theme}>
  <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
    <div>
      <span class="eyebrow">География</span>
      <h2 class="display mt-4 text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.05]">Где мы работаем</h2>
      <ul class="mt-12 border-t">
        {regions.map((r, i) => (
          <li class="flex items-baseline gap-6 border-b py-6">
            <span class="font-mono text-xs text-muted-foreground">0{i + 1}</span>
            <span class="font-display text-3xl font-light tracking-tight md:text-4xl">{r.title}</span>
            <span class="ml-auto text-right text-sm text-muted-foreground">офис · XX проектов</span>
          </li>
        ))}
        <li class="flex items-baseline gap-6 border-b py-6 text-muted-foreground">
          <span class="font-mono text-xs">—</span>
          <span class="font-display text-3xl font-light tracking-tight md:text-4xl">Вся Россия</span>
          <span class="ml-auto text-right text-sm">удалённо</span>
        </li>
      </ul>
    </div>
    <Placeholder class="min-h-80 lg:min-h-full" label="карта с городами" />
  </div>
</Section>
