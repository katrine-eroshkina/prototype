---
/**
 * pricing — пакеты. Консалтинг: «лестница входа», digital — помесячно.
 * «Цены» — оба набора; главная — анонс «от …» по группам.
 */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { packages, type PageCtx } from '@/data/content';
import { cn } from '@/lib/utils';
import { url } from '@/lib/url';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
const isHome = ctx.kind === 'home';
const sets = ctx.kind === 'prices'
  ? [packages({ ...ctx, direction: 'konsalting' }), packages({ ...ctx, direction: 'digital' })]
  : [packages(ctx)];
const teaser = [
  { dir: 'Консалтинг', from: 'от XX 000 ₽', note: 'Консультация, стратсессия, маркетолог на аутсорсе' },
  { dir: 'Digital', from: 'от XX 000 ₽/мес', note: 'SEO, реклама, Avito, SMM, таргет, нейросети' },
];
---
<Section id="pricing" {theme}>
  {isHome ? (
    <>
      <SectionHead eyebrow="Цены" title="Цены открыто" action={{ href: '/tseny/', label: 'Все пакеты' }} />
      <div class="grid gap-4 md:grid-cols-2">
        {teaser.map((t) => (
          <a href={url('/tseny/')} class="group rounded-xl border bg-card p-8 shadow-sm transition hover:shadow-md">
            <span class="text-sm text-muted-foreground">{t.dir}</span>
            <span class="mt-2 block text-3xl font-semibold tracking-tight">{t.from}</span>
            <span class="mt-3 block text-sm text-muted-foreground">{t.note}</span>
          </a>
        ))}
      </div>
    </>
  ) : sets.map((set, si) => (
    <div class={si > 0 ? 'mt-20' : ''}>
      <SectionHead eyebrow="Цены" title={set.title} />
      <div class="grid gap-4 lg:grid-cols-3">
        {set.list.map((p) => (
          <div class={cn('flex flex-col rounded-xl border bg-card p-8 shadow-sm', p.featured && 'border-primary ring-1 ring-primary')}>
            <div class="flex items-center justify-between">
              <h3 class="font-semibold">{p.name}</h3>
              {p.featured && <span class={badgeVariants()}>Чаще выбирают</span>}
            </div>
            <p class="mt-6"><span class="text-sm text-muted-foreground">от</span> <span class="text-4xl font-semibold tracking-tight">{p.price}</span></p>
            <p class="mt-1 text-sm text-muted-foreground">{p.note}</p>
            <ul class="mt-8 grid gap-3 text-sm">
              {p.items.map((i) => <li class="flex gap-2"><span aria-hidden="true">✓</span>{i}</li>)}
            </ul>
            <a class={cn(buttonVariants({ variant: p.featured ? 'default' : 'outline' }), 'mt-8')} href="#cta-form">Выбрать</a>
          </div>
        ))}
      </div>
    </div>
  ))}
</Section>
