---
/**
 * people:team — команда.
 * Главная: слева заголовок и ссылка «О компании», справа 4 человека сеткой 2×2 (Thrad, «О нас»).
 * О компании: все 8 — сеткой 4 в ряд.
 */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Placeholder from '../Placeholder.astro';
import { buttonVariants } from '@/components/ui/button';
import type { PageCtx } from '@/data/content';
import { cn } from '@/lib/utils';
import { url } from '@/lib/url';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
const isHome = ctx.kind === 'home';
const all = ['Основатель', 'Директор по маркетингу', 'Руководитель SEO', 'Руководитель рекламы', 'Аналитик', 'SMM-стратег', 'Специалист по Avito', 'Аккаунт-менеджер'];
const roles = isHome ? all.slice(0, 4) : all;
---
<Section id="people" variant="team" {theme}>
  {isHome ? (
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <span class="eyebrow">Команда</span>
        <h2 class="display mt-4 text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.05]">Команда, которая ведёт ваш проект</h2>
        <p class="mt-5 max-w-sm text-lg text-muted-foreground">XX специалистов. За каждым проектом — стратег, специалист по каналу и аналитик.</p>
        <a class={cn(buttonVariants({ variant: 'outline' }), 'mt-8 h-10 px-5')} href={url('/o-kompanii/')}>О компании <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10">
        {roles.map((r) => (
          <div>
            <Placeholder class="aspect-[4/5]" label="фото" />
            <p class="eyebrow mt-4">{r}</p>
            <p class="mt-1 font-display text-2xl font-light tracking-tight">Имя Фамилия</p>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <>
      <SectionHead eyebrow="Команда" title="Кто с вами работает" />
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
        {roles.map((r) => (
          <div>
            <Placeholder class="aspect-[4/5]" label="фото" />
            <p class="eyebrow mt-4">{r}</p>
            <p class="mt-1 font-display text-xl font-light tracking-tight">Имя Фамилия</p>
          </div>
        ))}
      </div>
    </>
  )}
</Section>
