---
/** contacts — телефон, почта, мессенджеры, адрес, реквизиты + карта (по PDF) */
import Section, { type Theme } from '../Section.astro';
import Placeholder from '../Placeholder.astro';
import type { PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
const rows = [
  ['Телефон', '+7 XXX XXX-XX-XX'],
  ['Почта', 'hello@burkov.agency'],
  ['Мессенджеры', 'Telegram · MAX · WhatsApp'],
  ['Офис', 'Город, улица, дом'],
];
---
<Section id="contacts" {theme}>
  <div class="grid gap-10 lg:grid-cols-2">
    <div>
      <dl class="divide-y border-y">
        {rows.map(([k, v]) => (
          <div class="grid grid-cols-[140px_1fr] gap-4 py-4">
            <dt class="text-sm text-muted-foreground">{k}</dt>
            <dd class="font-medium">{v}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-sm text-muted-foreground">ООО «…» · ИНН … · ОГРН …</p>
    </div>
    <Placeholder class="min-h-80" label="карта" />
  </div>
</Section>
