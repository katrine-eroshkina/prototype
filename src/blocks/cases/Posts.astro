---
/**
 * cases:posts — карточки статей блога, ведут на страницу статьи /blog/<slug>/.
 * На странице /blog/ — сразу после первого экрана, без заголовка блока: сетка + «Показать ещё».
 * На других страницах — анонс: заголовок + 3 статьи.
 */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Placeholder from '../Placeholder.astro';
import { badgeVariants } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { blogPosts as posts, type PageCtx } from '@/data/content';
import { cn } from '@/lib/utils';
import { url } from '@/lib/url';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
const isBlog = ctx.kind === 'blog';
const list = isBlog ? posts : posts.slice(0, 3);
---
<Section id="cases" variant="posts" theme={isBlog ? 'light' : theme} class={isBlog ? 'pt-8 md:pt-10' : ''}>
  {!isBlog && <SectionHead eyebrow="Блог" title="Статьи" action={{ href: '/blog/', label: 'Все статьи' }} />}
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {list.map((p) => (
      <a href={url(`/blog/${p.slug}/`)} class="group flex flex-col overflow-hidden rounded-xl border bg-card shadow-sm transition hover:shadow-md">
        <Placeholder class="aspect-[16/10] rounded-none border-0 border-b" label="обложка статьи" />
        <div class="flex flex-1 flex-col p-6">
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <span class={badgeVariants({ variant: 'secondary' })}>{p.r}</span>
            <span>5 мин</span>
          </div>
          <h3 class="mt-4 text-lg font-semibold group-hover:underline">{p.t}</h3>
          <p class="mt-auto pt-4 text-sm text-muted-foreground">12 октября 2026</p>
        </div>
      </a>
    ))}
  </div>
  {isBlog && (
    <div class="mt-10 flex justify-center">
      <button type="button" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }))}>Показать ещё</button>
    </div>
  )}
</Section>
