---
/**
 * cases:metrics — «было → стало» крупными цифрами на тёмном фоне.
 * На странице кейса — 5 метрик + место под график (как у business-up), на услуге — 3 примера.
 */
import Section, { type Theme } from '../Section.astro';
import Placeholder from '../Placeholder.astro';
import { caseStudy, sampleCases, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'dark' } = Astro.props;
const isCase = ctx.kind === 'case';
const items = isCase
  ? caseStudy.results.map((r) => ({ label: r.l, from: r.from, to: r.to, note: r.note }))
  : sampleCases.map((c) => ({ label: c.unit, from: c.from, to: c.to, note: `за ${c.period}` }));
---
<Section id="cases" variant="metrics" {theme}>
  <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{ctx.kind === 'service' ? 'Пример результата' : 'Результаты'}</h2>
  {/* Абзац — опционально: можно не заполнять, блок работает и без него */}
  <p class="mt-4 max-w-[450px] text-muted-foreground">
    Что изменилось для бизнеса: какие действия дали эффект и как это отразилось на выручке.
    <span class="ml-1 align-middle font-mono text-[10px] uppercase tracking-wider text-draft">опционально</span>
  </p>
  <div class:list={['mt-10 grid gap-8', isCase ? 'sm:grid-cols-2 lg:grid-cols-5' : 'md:grid-cols-3']}>
    {items.map((m) => (
      <div class="border-t pt-6">
        <p class="text-sm text-muted-foreground">{m.label}</p>
        <p class:list={['mt-2 font-semibold tracking-tight', isCase ? 'text-2xl' : 'text-3xl lg:text-4xl']}><span class="text-muted-foreground">{m.from}</span> → {m.to}</p>
        <p class="mt-2 text-sm text-muted-foreground">{m.note}</p>
      </div>
    ))}
  </div>
  {isCase && <Placeholder class="mt-10 aspect-[21/8]" label="график из Метрики: визиты и заявки по месяцам" />}
</Section>
