---
/**
 * cases:story — «Что сделали»: этапы работ таймлайном (референс — Aceternity Timeline + Sticky Scroll).
 * Слева заголовок этапа (номер, название, период), по центру линия с точками,
 * которая заполняется при прокрутке; справа — работы, результат этапа и 2 скриншота.
 * Код свой: Tailwind + немного JS для линии прогресса.
 */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Placeholder from '../Placeholder.astro';
import { caseStudy as cs, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
---
<Section id="cases" variant="story" {theme}>
  <SectionHead eyebrow="Решение" title="Что сделали" lead={`${cs.stages.length} этапа за 8 месяцев — от технической основы до контента.`} />

  <div class="relative" data-timeline>
    <!-- Линия: серая основа + заполнение по прокрутке -->
    <div class="absolute bottom-0 left-[15px] top-2 w-px bg-border md:left-[279px]" aria-hidden="true">
      <div class="w-full origin-top bg-foreground motion-reduce:hidden" style="height: 0" data-timeline-fill></div>
    </div>

    <ol class="grid gap-16 md:gap-24">
      {cs.stages.map((s, i) => (
        <li class="relative grid gap-6 pl-12 md:grid-cols-[264px_1fr] md:gap-16 md:pl-0">
          <!-- Точка на линии -->
          <span class="absolute left-[9px] top-2 size-[13px] rounded-full border-2 border-foreground bg-background md:left-[273px]" aria-hidden="true"></span>

          <!-- Заголовок этапа -->
          <div class="md:pr-6 md:text-right">
            <span class="font-mono text-sm text-muted-foreground">Этап {i + 1} · {s.period}</span>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight">{s.t}</h3>
          </div>

          <!-- Содержимое этапа -->
          <div class="md:pl-6">
            <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
              {s.works.map((w) => <li class="flex gap-2"><span aria-hidden="true">✓</span>{w}</li>)}
            </ul>
            <p class="mt-6 rounded-lg bg-muted px-5 py-4">
              <span class="block text-xs font-medium uppercase tracking-wider text-muted-foreground">Результат этапа</span>
              <span class="mt-1 block font-medium">{s.result}</span>
            </p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {s.media.map((m) => <Placeholder class="aspect-[4/3]" label={m} />)}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>

<script>
  // Линия таймлайна заполняется по мере прокрутки (тихое движение; отключается при reduce motion)
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
  if (tl && fill && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const update = () => {
      const r = tl.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
      fill.style.height = `${progress * 100}%`;
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
