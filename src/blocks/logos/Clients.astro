---
/** logos:clients — логотипы клиентов одной строкой */
import Section, { type Theme } from '../Section.astro';
import type { PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
---
<Section id="logos" variant="clients" {theme} class="py-12 md:py-14">
  <div class="flex flex-col gap-6 border-y py-8 md:flex-row md:items-center md:gap-12">
    <p class="shrink-0 text-sm text-muted-foreground">Нам доверяют</p>
    <div class="grid flex-1 grid-cols-3 gap-6 md:grid-cols-6">
      {Array.from({ length: 6 }, () => <div class="h-8 rounded bg-muted"></div>)}
    </div>
  </div>
</Section>
