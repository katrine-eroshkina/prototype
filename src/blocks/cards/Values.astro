---
/** cards:values — принципы работы (6 пунктов). У конкурентов это есть на каждой странице «О компании». */
import Section, { type Theme } from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { values, type PageCtx } from '@/data/content';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'light' } = Astro.props;
---
<Section id="cards" variant="values" {theme}>
  <SectionHead eyebrow="Принципы" title="Как мы работаем" />
  <div class="grid gap-px overflow-hidden rounded-xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
    {values.map((v, i) => (
      <div class="bg-card p-6 md:p-8">
        <span class="font-mono text-sm text-muted-foreground">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-semibold">{v.t}</h3>
        <p class="mt-2 text-sm text-muted-foreground">{v.d}</p>
      </div>
    ))}
  </div>
</Section>
