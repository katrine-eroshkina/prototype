---
/** cta:cross — переход в другое направление (Digital ↔ Консалтинг) */
import Section, { type Theme } from '../Section.astro';
import { buttonVariants } from '@/components/ui/button';
import { crossSell, type PageCtx } from '@/data/content';
import { url } from '@/lib/url';

interface Props { ctx: PageCtx; theme?: Theme }
const { ctx, theme = 'light' } = Astro.props;
const c = crossSell(ctx);
---
<Section id="cta" variant="cross" {theme} class="py-12 md:py-16">
  <div class="flex flex-col justify-between gap-6 rounded-2xl bg-muted p-8 md:flex-row md:items-center md:p-10">
    <div>
      <p class="text-sm text-muted-foreground">{c.eyebrow}</p>
      <h2 class="mt-1 text-2xl font-semibold tracking-tight">{c.title}</h2>
      <p class="mt-2 text-muted-foreground">{c.text}</p>
    </div>
    <a class={buttonVariants()} href={url(c.href)}>{c.cta} →</a>
  </div>
</Section>
