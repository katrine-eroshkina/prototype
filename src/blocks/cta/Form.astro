---
/**
 * cta:form — финальная форма заявки. Последний блок перед подвалом, фон тёмный тёплый (как у Thrad),
 * переходит в тёмный подвал. Поля — с подчёркиванием (Soulera).
 */
import Section, { type Theme } from '../Section.astro';
import { buttonVariants } from '@/components/ui/button';
import type { PageCtx } from '@/data/content';
import { cn } from '@/lib/utils';

interface Props { ctx: PageCtx; theme?: Theme }
const { theme = 'dark' } = Astro.props;
const field = 'w-full border-0 border-b border-input bg-transparent px-0 py-3 text-lg outline-none transition placeholder:text-muted-foreground focus:border-brand';
---
<Section id="cta" variant="form" {theme} class="md:py-28">
  <div class="grid gap-14 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
    <div class="flex flex-col">
      <span class="eyebrow">Следующий шаг</span>
      <h2 class="display mt-4 text-5xl leading-[1] md:text-7xl">Расскажите о задаче</h2>
      <p class="mt-6 max-w-md text-lg text-muted-foreground">Ответим в течение рабочего дня. Первая консультация — бесплатно.</p>
      <div class="mt-auto flex flex-wrap gap-x-8 gap-y-3 pt-12 text-lg">
        {['Telegram', 'MAX', '+7 XXX XXX-XX-XX'].map((m) => <a class="underline decoration-foreground/30 underline-offset-8 transition hover:decoration-brand" href="#">{m}</a>)}
      </div>
    </div>
    <form class="grid content-start gap-6" data-lead-form>
      <input class={field} placeholder="Имя" />
      <input class={field} placeholder="Телефон или Telegram" />
      <textarea class={cn(field, 'resize-none')} rows={3} placeholder="Коротко о задаче"></textarea>
      <label class="flex items-center gap-2 text-sm text-muted-foreground"><input type="checkbox" class="accent-[var(--brand)]" /> Согласен с политикой обработки данных</label>
      <button class={cn(buttonVariants({ size: 'lg' }), 'mt-2 h-12 justify-between px-6 text-base sm:w-64')} type="submit">Отправить <span aria-hidden="true">+</span></button>
    </form>
  </div>
</Section>
