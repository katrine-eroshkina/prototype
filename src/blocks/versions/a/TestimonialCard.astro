---
/**
 * А · карточка отзыва для блока отзывов.
 * Светло-серая, скругление 16: цифра «было → стало» 40/48 и подпись, цитата, автор.
 * Справа внизу — компактная серая ссылка «Отзыв ↗»: открывает поп-ап отзыва (ReviewModal) с видео или благодарственным письмом (PDF).
 */
import { FileText, ArrowUpRight } from 'lucide-react';
import Roll from './Roll.astro';
interface Props { t: { from: string; to: string; unit: string; q: string; n: string; r: string; kind: string; src: string }; class?: string }
const { t, class: className } = Astro.props;
---
<figure class:list={["flex flex-col rounded-2xl bg-surface p-6 md:p-8", className]}>
  <p class="t-h2 flex items-center gap-2 whitespace-nowrap">
    <span class="text-fg-muted">{t.from}</span>
    <svg class="size-7 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-label="стало"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    <span class="text-fg">{t.to}</span>
  </p>
  <p class="mt-1 text-sm leading-5 text-fg-muted">{t.unit}</p>
  <blockquote class="mt-8 text-base leading-6 text-fg">«{t.q}»</blockquote>
  <figcaption class="mt-auto flex items-end justify-between gap-4 pt-8">
    <span class="text-base leading-6"><span class="block text-fg">{t.n}</span><span class="block text-sm leading-5 text-fg-muted">{t.r}</span></span>
    <button type="button" class="flex h-5 shrink-0 cursor-pointer items-center gap-1 text-sm leading-5 text-fg-muted" data-review={t.kind} data-src={t.src} data-caption={`${t.n} · ${t.r}`} aria-label={t.kind === 'video' ? 'Смотреть видеоотзыв' : 'Открыть благодарственное письмо, PDF'}>
      <FileText size={16} strokeWidth={1.75} aria-hidden="true" /><Roll>Отзыв</Roll><ArrowUpRight size={14} strokeWidth={1.75} aria-hidden="true" />
    </button>
  </figcaption>
</figure>

