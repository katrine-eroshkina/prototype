---
/**
 * А · карточка отзыва для блока отзывов.
 * Светло-серая, скругление 16: цифра «было → стало» 40/48 и подпись, цитата, автор; справа внизу — ссылка на благодарственное письмо (PDF).
 */
import { FileText, ArrowUpRight } from 'lucide-react';
interface Props { t: { from: string; to: string; unit: string; q: string; n: string; r: string }; class?: string }
const { t, class: className } = Astro.props;
---
<figure class:list={["flex flex-col rounded-2xl bg-[#fafaf9] p-6 md:p-8", className]}>
  <p class="tm-kpi flex items-center gap-2 whitespace-nowrap text-[40px] leading-[48px]">
    <span class="text-[#878787]">{t.from}</span>
    <svg class="size-7 shrink-0 text-[#878787]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-label="стало"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    <span class="text-[#0c0d0f]">{t.to}</span>
  </p>
  <p class="mt-1 text-sm leading-5 text-[#878787]">{t.unit}</p>
  <blockquote class="mt-8 text-base leading-6 text-[#2c2c2c]">«{t.q}»</blockquote>
  <figcaption class="mt-auto flex items-end justify-between gap-4 pt-8">
    <span class="text-base leading-6"><span class="block text-[#2c2c2c]">{t.n}</span><span class="block text-sm leading-5 text-[#878787]">{t.r}</span></span>
    <a class="flex h-5 shrink-0 items-center gap-1 text-sm leading-5 text-[#878787] transition hover:text-[#2c2c2c]" href="#" title="Благодарственное письмо (PDF)" aria-label="Отзыв — благодарственное письмо, PDF">
      <FileText size={16} strokeWidth={1.75} aria-hidden="true" />Отзыв<ArrowUpRight size={14} strokeWidth={1.75} aria-hidden="true" />
    </a>
  </figcaption>
</figure>

<style>
  .tm-kpi { font-family: var(--font-display); font-weight: 300; letter-spacing: -0.03em; font-variant-ligatures: none; }
</style>
