---
/**
 * А · cta:form — по центру заголовок в одну строку и короткая форма (имя, телефон, согласие на обработку данных). Скругление 16.
 * Фон — как на первом экране (HeroBg: размытые голубые полосы, зерно) без слова и без плывущего пятна.
 * Вместо него — два световых пятна по углам (сверху слева и снизу справа), мерцают по очереди.
 */
import Section from '../../Section.astro';
import Btn from './Btn.astro';
import HeroBg from './HeroBg.astro';
import Field from './Field.astro';
import Consent from './Consent.astro';
---
<Section id="cta" variant="form">
  <div class="relative overflow-hidden rounded-2xl px-6 py-16 md:px-10 md:py-24">
    <HeroBg word={false} fade={false} light={false} />
    <span class="cta-glow -left-[10%] -top-[30%]" aria-hidden="true"></span>
    <span class="cta-glow cta-glow-2 -bottom-[30%] -right-[10%]" aria-hidden="true"></span>

    <div class="relative flex flex-col items-center text-center">
      <h2 class="t-h1 text-balance text-fg md:whitespace-nowrap">Не знаете, с чего начать?</h2>
      <p class="mt-2 max-w-[400px] text-base leading-6 text-fg">Расскажите о задаче. Ответим в течение рабочего дня, первая консультация — бесплатно</p>
      <form class="mt-8 grid w-full max-w-sm gap-4" data-lead-form data-consent-form>
        <Field placeholder="Имя" />
        <Field placeholder="Телефон или Telegram" />
        <Btn as="button" type="submit" full class="mt-4" disabled data-consent-submit>Отправить</Btn>
        <Consent class="mt-2" />
      </form>
    </div>

  </div>
</Section>


<style>
  .cta-glow { position: absolute; z-index: 3; width: 45%; aspect-ratio: 1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, #fff 0%, rgba(255,255,255,0) 100%); filter: blur(60px); mix-blend-mode: plus-lighter;
    opacity: 0; animation: cta-glow 8s ease-in-out infinite; }
  .cta-glow-2 { animation-delay: -4s; }
  @keyframes cta-glow { 0%, 100% { opacity: 0; transform: scale(.9); } 50% { opacity: .3; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .cta-glow { animation: none; opacity: .3; } }
</style>
