---
/**
 * А · services:groups на главной — структура как в версии Б: слева заголовок блока и кнопка «Все услуги и цены»,
 * справа раскрывающийся список категорий по группам Консалтинг / Digital.
 * Оформление А: без линий, строки — светло-серые плашки surface со скруглением 16;
 * открыта одна строка (details с общим name). Название одним цветом. Внутри: что это, подуслуги, цена и две кнопки.
 * Подробные карточки — на странице «Все услуги» (ServicesCatalog).
 */
import Section from '../../Section.astro';
import Btn from './Btn.astro';
import SectionHead from './SectionHead.astro';
import { groups, catUrl, serviceUrl } from '@/data/sitemap';
import { categoryAbout, serviceCardA } from '@/data/content';
import { url } from '@/lib/url';
import Badge from './Badge.astro';
import MoreLink from './MoreLink.astro';
import AccRow from './AccRow.astro';
import Price from './Price.astro';
const noDot = (s?: string) => s?.replace(/\.$/, '');
---
<Section id="services" variant="groups" class="lg:border-x-0">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div class="lg:self-start">
      <SectionHead eyebrow="Услуги">
        Решения под вашу задачу
        <Fragment slot="lead">Строим понятную цепочку: находим точки роста, подбираем инструменты и сами их запускаем</Fragment>
      </SectionHead>
      <Btn class="mt-8" href={url('/uslugi/')}>Все услуги и цены</Btn>
    </div>

    <div class="grid gap-10">
      {groups.map((g) => (
        <div>
          <p class="mb-3 text-base leading-6 text-fg-muted">{g.title}</p>
          <div class="grid gap-1">
            {g.categories.map((c, k) => {
              const t = serviceCardA[c.slug];
              const about = categoryAbout[c.slug];
              return (
                <AccRow name="svc-a" open={g.slug === 'konsalting' && k === 0}>
                  <span slot="title" class="t-h4 text-fg">{t.accent}{t.rest.startsWith('-') ? '' : ' '}{t.rest}</span>
                  {about && <p class="max-w-[600px] text-base leading-6 text-fg-muted">{noDot(about.what)}</p>}
                  {c.children.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1">
                      {c.children.map((s) => <Badge as="a" href={url(serviceUrl(c, s))}>{s.title}</Badge>)}
                    </div>
                  )}
                  <Price class="mt-6" per={g.slug === 'digital' ? '/мес' : undefined} />
                  <div class="mt-4 flex flex-wrap items-center gap-2">
                    <Btn href="#cta-form" data-lead={`${t.accent}${t.rest.startsWith('-') ? '' : ' '}${t.rest}`}>Обсудить</Btn>
                    <MoreLink class="ml-4" href={url(catUrl(c))}>Подробнее</MoreLink>
                  </div>
                </AccRow>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</Section>

