---
/**
 * А · faq — как список услуг на главной А: слева заголовок блока, справа вопросы светло-серыми плашками
 * (#fafaf9, скругление 16), открыт один (details с общим name), справа белый кружок с плюсом.
 */
import Section from '../../Section.astro';
import SectionHead from './SectionHead.astro';
import { faq, type PageCtx } from '@/data/content';
interface Props { ctx: PageCtx }
const { ctx } = Astro.props;
---
<Section id="faq">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div class="lg:self-start">
      <SectionHead eyebrow="Вопросы">Частые вопросы</SectionHead>
      <p class="mt-2 text-base leading-6 text-[#878787]">Не нашли ответ? <a class="font-medium text-[#0c0d0f]" href="#cta-form"><span class="roll"><span>Спросите нас ›</span><span aria-hidden="true">Спросите нас ›</span></span></a></p>
    </div>
    <div class="grid gap-1">
      {faq(ctx).map((f, i) => (
        <details name="faq-a" class="faq-row rounded-2xl bg-[#fafaf9]" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 md:px-6">
            <span class="text-lg leading-7 text-[#0c0d0f]">{f.q}</span>
            <!-- «+» в кружке 24×24, тёмно-серый — как в услугах; при раскрытии поворачивается в «×» -->
            <svg class="faq-plus size-6 shrink-0 text-[#66696f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="11.25" /><path d="M12 7.5v9M7.5 12h9" /></svg>
          </summary>
          <p class="max-w-[600px] px-5 pb-6 text-base leading-6 text-[#878787] md:px-6">{f.a.replace(/\.$/, '')}</p>
        </details>
      ))}
    </div>
  </div>
</Section>

<style>
  .faq-row summary::-webkit-details-marker { display: none; }
  .faq-plus { transition: transform .25s, color .2s; }
  .faq-row summary:hover .faq-plus { color: var(--brand); }
  .faq-row[open] .faq-plus { transform: rotate(45deg); }
  .faq-row { interpolate-size: allow-keywords; }
  .faq-row::details-content { block-size: 0; overflow: hidden; transition: block-size .3s ease, content-visibility .3s allow-discrete; }
  .faq-row[open]::details-content { block-size: auto; }
</style>
