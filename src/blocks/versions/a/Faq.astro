---
/**
 * А · faq — как список услуг на главной А: слева заголовок блока, справа вопросы светло-серыми плашками
 * (surface, скругление 16), открыт один (details с общим name), справа белый кружок с плюсом.
 */
import Section from '../../Section.astro';
import SectionHead from './SectionHead.astro';
import { faq, type PageCtx } from '@/data/content';
import MoreLink from './MoreLink.astro';
import AccRow from './AccRow.astro';
interface Props { ctx: PageCtx }
const { ctx } = Astro.props;
---
<Section id="faq">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div class="lg:self-start">
      <SectionHead eyebrow="Вопросы">Частые вопросы</SectionHead>
      <p class="mt-2 text-base leading-6 text-fg-muted">Не нашли ответ? <MoreLink inline href="#cta-form">Спросите нас</MoreLink></p>
    </div>
    <div class="grid gap-1">
      {faq(ctx).map((f, i) => (
        <AccRow name="faq-a" open={i === 0}>
          <span slot="title" class="t-h5 text-fg">{f.q}</span>
          <p class="max-w-[600px] text-base leading-6 text-fg-muted">{f.a.replace(/\.$/, '')}</p>
        </AccRow>
      ))}
    </div>
  </div>
</Section>


