---
/**
 * А · cases — текст кейса слева прямо на белом фоне, фото справа (текстовая часть — как в версии В:
 * клиент, «результат за срок», пояснение в 2 строки серым, услуги тегами, «было → стало», «Читать кейс»).
 * Переключение — как у Brandigo (/projects), сняли покадрово:
 *  — всё движется одновременно, без задержек;
 *  — пружина: ~0,5 с до места, перелёт ~1,5 % и мягкий возврат к ~1 с;
 *  — направление чередуется: счётчик вверх, «Клиент» вниз, итог вверх, пояснение вниз, теги вверх, результат вниз, подпись вверх; фото вверх;
 *  — у каждого элемента своё окошко (счётчик, клиент, описание, теги, результат, фото), ничего не проезжает поверх соседей;
 *  — управление внизу: «Читать кейс» слева, справа ‹ 01 / 03 ›;
 *  — без закольцовывания: на первом/последнем кейсе ненужная стрелка полупрозрачная.
 * Телефон (отступы по Figma, Cases / Slider · Mobile): шапка → 40 → фото 4:3 → 16 → текст; клиент, итог, описание, теги, результат — через 8;
 *  подпись к результату вплотную; → 16 → «Читать кейс»; поверх фото — стрелки по бокам (40px) и точки внизу (по нажатию — к кейсу);
 *  кейсы листаются и свайпом по фото. Внизу остаётся только «Читать кейс».
 */
import Section from '../../Section.astro';
import Btn from './Btn.astro';
import SectionHead from './SectionHead.astro';
import { sampleCases } from '@/data/content';
import { cases as caseLinks } from '@/data/sitemap';
import { url } from '@/lib/url';
import Badge from './Badge.astro';
const items = sampleCases.map((c, i) => ({ ...c, n: String(i + 1).padStart(2, '0'), href: url(`/keisy/${caseLinks[i % caseLinks.length].slug}/`) }));
const total = String(items.length).padStart(2, '0');
---
<Section id="cases" variant="grid">
  <SectionHead eyebrow="Кейсы" link={{ href: '/keisy/', label: 'Все кейсы' }}>
    Как клиенты растут с burkov/agency
  </SectionHead>

  <div class="mt-10 grid gap-4 lg:mt-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16" data-cs data-hrefs={JSON.stringify(items.map((c) => c.href))} style="--i:0">
    <!-- Фото проекта; на телефоне поверх него — стрелки по бокам и точки внизу -->
    <div class="cs-roll aspect-[4/3] touch-pan-y rounded-2xl lg:order-2 lg:aspect-[3/2]" data-cs-swipe>
      <div class="cs-stack h-full">
        {items.map((_, j) => (
          <div class="cs-photo relative" style={`--j:${j}`} data-j={j}>
            <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-xs text-fg-inverse/50">фото проекта / клиента</span>
          </div>
        ))}
      </div>
      <button type="button" class="cs-ov left-3" data-cs-prev aria-label="Предыдущий кейс" disabled><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg></button>
      <button type="button" class="cs-ov right-3" data-cs-next aria-label="Следующий кейс"><svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
      <div class="absolute inset-x-0 bottom-3 flex justify-center gap-2 lg:hidden" role="tablist" aria-label="Кейсы">
        {items.map((c, j) => <button type="button" class="cs-dot" role="tab" aria-label={`Кейс ${c.n}: ${c.client}`} data-cs-dot={j}></button>)}
      </div>
    </div>

    <!-- Текст кейса — прямо на белом фоне -->
    <div class="flex flex-col">
      <div class="cs-roll">
        <div class="cs-stack cs-rev">{items.map((c, j) => <p class="cs-client t-h3 whitespace-nowrap text-fg" style={`--j:${j}`} data-j={j}>{c.client}</p>)}</div>
      </div>
      <div class="cs-roll mt-2 lg:mt-4">
        <div class="cs-stack">{items.map((c, j) => <p class="t-h5 text-fg" style={`--j:${j}`} data-j={j}>{c.title} за {c.period}</p>)}</div>
      </div>
      <div class="cs-roll mt-2">
        <div class="cs-stack cs-rev">{items.map((c, j) => <p class="text-sm leading-5 text-fg-muted" style={`--j:${j}`} data-j={j}>{c.d}</p>)}</div>
      </div>
      <div class="cs-roll mt-2 lg:mt-6">
        <div class="cs-stack">
          {items.map((c, j) => (
            <ul class="flex flex-wrap gap-1" aria-label="Услуги" style={`--j:${j}`} data-j={j}>
              {[c.tag, 'Аналитика'].map((s) => <Badge as="li">{s}</Badge>)}
            </ul>
          ))}
        </div>
      </div>

      <div class="mt-auto pt-2 lg:pt-10">
        <div class="cs-roll">
          <div class="cs-stack cs-rev">
            {items.map((c, j) => (
              <p class="t-h2 flex items-center gap-2 whitespace-nowrap text-fg" style={`--j:${j}`} data-j={j}>
                <span class="text-fg-muted">{c.from}</span>
                <svg class="size-7 shrink-0 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-label="стало"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                <span class="text-fg">{c.to}</span>
              </p>
            ))}
          </div>
        </div>
        <div class="cs-roll lg:mt-1">
          <div class="cs-stack">{items.map((c, j) => <p class="text-sm leading-5 text-fg-muted" style={`--j:${j}`} data-j={j}>{c.unit}</p>)}</div>
        </div>
        <div class="mt-4 flex items-center justify-between gap-4 lg:mt-6">
          <Btn href={items[0].href} data-cs-link>Читать кейс</Btn>
          <div class="hidden items-center gap-3 lg:flex">
            <button type="button" class="cs-btn" data-cs-prev aria-label="Предыдущий кейс" disabled>
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <p class="flex text-sm leading-5 tabular-nums text-fg-muted">
              <span class="cs-roll h-5"><span class="cs-stack">{items.map((c, j) => <span style={`--j:${j}`} data-j={j}>{c.n}</span>)}</span></span>
              <span>&nbsp;/ {total}</span>
            </p>
            <button type="button" class="cs-btn" data-cs-next aria-label="Следующий кейс">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Имя клиента — обычным начертанием, как заголовки; тонкое (300) только у цифр результата */
  .cs-client { font-weight: 400; letter-spacing: -0.02em; }
  /* Окошко: всё, что за его пределами, не видно — поэтому ничего не наезжает на соседние элементы */
  .cs-roll { display: block; overflow: hidden; position: relative; }
  /* Все варианты в одной ячейке: высота окошка = самый высокий вариант. Сдвиг = (свой номер − текущий) × своя высота */
  .cs-stack { display: grid; }
  /* Соседние варианты стоят с запасом 8px за краем окошка — иначе при дробном масштабе экрана от них просвечивает полоска */
  .cs-stack > * { grid-area: 1 / 1; transform: translateY(calc((var(--j) - var(--i)) * (100% + 8px)));
    /* Пружина как у Brandigo: 0,5 с до места, перелёт ~1,5 %, к 1 с — покой */
    transition: transform 1s linear(0, 0.15 8.6%, 0.5 17.9%, 0.78 27.3%, 0.93 36.6%, 0.995 46%, 1.015 55.5%, 1.013 64.8%, 1.008 74.1%, 1.003 83.5%, 1.001 92.8%, 1); }
  /* Соседние строки едут навстречу друг другу: счётчик вверх, «Клиент» вниз, описание вверх, теги вниз… */
  .cs-stack.cs-rev > * { transform: translateY(calc((var(--i) - var(--j)) * (100% + 8px))); }
  .cs-photo { background: radial-gradient(120% 90% at 30% 20%, #5b6b80 0%, #2a323d 55%, #121519 100%); }
  /* Стрелки — светло-серые квадраты 32px; на краю списка — полупрозрачная и неактивная */
  .cs-btn { display: grid; place-items: center; width: 32px; height: 32px; background: var(--stroke); color: var(--fg); transition: background-color .2s, color .2s, opacity .3s; }
  .cs-btn:hover:not(:disabled) { background: var(--action); color: var(--on-action); }
  .cs-btn:disabled { opacity: .3; cursor: default; }
  /* телефон: стрелки поверх фото (40px, светлая плашка с размытием), на краю списка ненужная прячется; точки внизу по центру */
  .cs-ov { position: absolute; top: 50%; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; margin-top: -20px; border-radius: 999px;
    background: color-mix(in srgb, var(--page) 90%, transparent); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); color: var(--fg); transition: opacity .3s; }
  .cs-ov:disabled { opacity: 0; pointer-events: none; }
  @media (min-width: 1024px) { .cs-ov { display: none; } }
  .cs-dot { position: relative; width: 6px; height: 6px; border-radius: 999px; background: rgb(255 255 255 / .45); transition: background-color .3s, width .3s; }
  .cs-dot::after { content: ''; position: absolute; inset: -10px -5px; }
  .cs-dot[aria-selected="true"] { width: 16px; background: #fff; }
  @media (prefers-reduced-motion: reduce) { .cs-stack > * { transition: none; } }
</style>

<script>
  // --i — номер текущего кейса; невидимые варианты скрыты от экранных чтецов; «Читать кейс» ведёт на текущий
  document.querySelectorAll<HTMLElement>('[data-cs]').forEach((root) => {
    const hrefs = JSON.parse(root.dataset.hrefs || '[]') as string[];
    const n = hrefs.length || 1;
    const prevs = root.querySelectorAll<HTMLButtonElement>('[data-cs-prev]');
    const nexts = root.querySelectorAll<HTMLButtonElement>('[data-cs-next]');
    const dots = root.querySelectorAll<HTMLButtonElement>('[data-cs-dot]');
    const link = root.querySelector<HTMLAnchorElement>('[data-cs-link]');
    const variants = root.querySelectorAll<HTMLElement>('[data-j]');
    let i = 0;
    const go = (k: number) => {
      i = Math.max(0, Math.min(n - 1, k));
      root.style.setProperty('--i', String(i));
      variants.forEach((v) => v.setAttribute('aria-hidden', String(Number(v.dataset.j) !== i)));
      prevs.forEach((b) => (b.disabled = i === 0));
      nexts.forEach((b) => (b.disabled = i === n - 1));
      dots.forEach((d, j) => d.setAttribute('aria-selected', String(j === i)));
      if (link && hrefs[i]) link.href = hrefs[i];
    };
    prevs.forEach((b) => b.addEventListener('click', () => go(i - 1)));
    nexts.forEach((b) => b.addEventListener('click', () => go(i + 1)));
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    // свайп по фото: влево — следующий, вправо — предыдущий
    const sw = root.querySelector<HTMLElement>('[data-cs-swipe]');
    let x0 = 0, y0 = 0;
    sw?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    sw?.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(i + (dx < 0 ? 1 : -1)); }, { passive: true });
    go(0);
  });
</script>
