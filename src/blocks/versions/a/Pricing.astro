---
/**
 * А · pricing — три пакета рядом: светло-серые карточки (surface, скругление 16).
 * Название + формат серым, цена, список «что входит» с белыми галочками в синих кружках, кнопка «Обсудить задачу» внизу.
 * Главная — три общих пакета (pricingA). Внутренние страницы — пакеты направления (packages), на «Ценах» — оба набора;
 * у пакета «Чаще выбирают» — синяя метка.
 */
import Section from '../../Section.astro';
import Btn from './Btn.astro';
import SectionHead from './SectionHead.astro';
import { Check } from 'lucide-react';
import { pricingA, packages, type PageCtx } from '@/data/content';
import Price from './Price.astro';
import Badge from './Badge.astro';
interface Props { ctx: PageCtx }
const { ctx } = Astro.props;
const isHome = ctx.kind === 'home';
type Card = { name: string; note: string; price: string; items: string[]; featured?: boolean };
const sets: { title: string; list: Card[] }[] = isHome
  ? [{ title: 'Цены открыто', list: pricingA }]
  : ctx.kind === 'prices'
    ? [packages({ ...ctx, direction: 'konsalting' }), packages({ ...ctx, direction: 'digital' })]
    : [packages(ctx)];
// «XX 000 ₽/мес» → цена и «/мес» отдельно (мелким серым)
const split = (p: string) => { const [v, per] = p.split('/'); return { v: v.trim(), per: per ? '/' + per : '' }; };
---
<Section id="pricing">
  {sets.map((set, si) => (
    <div class={si > 0 ? 'mt-20' : ''}>
      {isHome ? (
        <SectionHead eyebrow="Цены" lead="Без скрытых платежей и долгих договоров. Точную смету даём после брифа" link={{ href: '/tseny/', label: 'Все пакеты' }}>
          Цены открыто
        </SectionHead>
      ) : (
        <SectionHead eyebrow="Цены">{set.title}</SectionHead>
      )}
      <ul class="mt-10 md:mt-12 grid gap-3 lg:grid-cols-3">
        {set.list.map((t) => {
          const pr = split(t.price);
          return (
            <li class="flex flex-col rounded-2xl bg-surface p-6 md:p-8">
              <div class="flex items-start justify-between gap-4">
                <p class="t-h4 text-fg">{t.name}</p>
                {t.featured && <Badge class="shrink-0">Чаще выбирают</Badge>}
              </div>
              <p class="mt-1 text-base leading-6 text-fg-muted">{t.note.charAt(0).toUpperCase() + t.note.slice(1)}</p>
              <Price class="mt-8" value={pr.v} per={pr.per || undefined} />
              <ul class="mt-8 grid gap-3 border-t border-stroke pt-6">
                {t.items.map((it) => (
                  <li class="flex gap-3 text-base leading-6 text-fg"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand-bg text-on-brand" aria-hidden="true"><Check size={12} strokeWidth={3} /></span>{it}</li>
                ))}
              </ul>
              <div class="mt-auto pt-10">
                <Btn full href="#cta-form" data-lead={`Тариф «${t.name}»`}>Обсудить задачу</Btn>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</Section>

