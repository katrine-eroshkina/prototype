---
/**
 * А · contacts — сетка как у блоков главной (1fr / 1.4fr).
 * Слева: телефон, почта (с серой иконкой «копировать»), мессенджеры (ссылки с чёрными иконками) и реквизиты (кнопка «скачать») — без подложек, в одну колонку, с отступом 24 между пунктами, от верха карты
 * (подпись серым, значение шрифтом заголовков — как факты в hero).
 * Реквизиты — только в подвале. Справа: карта как в «Географии» на главной — снимок OpenStreetMap
 * в оттенках серого с метками офисов цветом бренда.
 */
import Section from '../../Section.astro';
import { ArrowUpRight, Check, Copy } from 'lucide-react';
import Messenger from '@/components/icons/Messenger.astro';
import Btn from './Btn.astro';
import type { PageCtx } from '@/data/content';
interface Props { ctx: PageCtx }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = 'hello@burkov.agency';
// Ссылки на мессенджеры — заглушки, ждём от заказчика
const messengers = [
  { t: 'Telegram', icon: 'telegram' as const, href: 'https://t.me/' },
  { t: 'MAX', icon: 'max' as const, href: '#' },
  { t: 'WhatsApp', icon: 'whatsapp' as const, href: 'https://wa.me/' },
];
// Положение меток на снимке карты, % от ширины/высоты (как в «Географии»)
const pins = [{ t: 'Москва', x: 62.7, y: 68.3 }, { t: 'Санкт-Петербург', x: 37.3, y: 31.6 }];
---
<Section id="contacts" class="pt-12 md:pt-14">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-8">
    <div class="flex flex-col">
      <dl class="flex flex-col gap-6">
        <div class="ct-card">
          <dt class="text-sm leading-5 text-[#878787]">Телефон</dt>
          <dd class="ct-v mt-2 text-xl leading-7"><a href="tel:+70000000000">+7 XXX XXX-XX-XX</a></dd>
        </div>
        <!-- Почта: кнопка «копировать» — по клику адрес в буфере, иконка на секунду меняется на галочку -->
        <div class="ct-card">
          <dt class="text-sm leading-5 text-[#878787]">Почта</dt>
          <dd class="mt-2 flex items-center gap-3">
            <a class="ct-v text-xl leading-7" href={`mailto:${email}`}>{email}</a>
            <button type="button" class="flex h-8 items-center gap-1.5 text-sm text-[#878787] transition-colors hover:text-[#0c0d0f]" data-copy={email} aria-label="Скопировать почту">
              <span data-copy-ic><Copy size={16} strokeWidth={1.75} /></span>
              <span class="hidden" data-copy-ok><Check size={16} strokeWidth={2} /></span>
              <span class="hidden" data-copy-msg>Скопировано</span>
            </button>
          </dd>
        </div>
        <!-- Мессенджеры: ссылки без подложки — чёрная иконка, название, стрелка; при наведении название перекатывается, стрелка сдвигается -->
        <div class="ct-card">
          <dt class="text-sm leading-5 text-[#878787]">Мессенджеры</dt>
          <dd class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
            {messengers.map((m) => (
              <a class="group flex h-8 items-center gap-2 text-base font-medium text-[#0c0d0f]" href={m.href} target="_blank" rel="noopener">
                <Messenger name={m.icon} size={20} mono /><span class="roll"><span>{m.t}</span><span aria-hidden="true">{m.t}</span></span><ArrowUpRight size={14} strokeWidth={2} className="-ml-1 text-[#878787] transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </a>
            ))}
          </dd>
        </div>
        <!-- Реквизиты: кнопка «скачать» (карточка компании, файл ждём от заказчика) -->
        <div class="ct-card">
          <dt class="text-sm leading-5 text-[#878787]">Реквизиты</dt>
          <dd class="mt-3"><Btn href="#" icon="download" download>Скачать реквизиты</Btn></dd>
        </div>
      </dl>
    </div>
    <!-- Карта на десктопе — по высоте левой колонки: снимок 4:3 по центру, лишнее срезается сверху и снизу, метки едут вместе со снимком -->
    <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-[#fafaf9] lg:aspect-auto">
      <div class="absolute inset-x-0 top-1/2 aspect-[4/3] -translate-y-1/2">
        <img class="absolute inset-0 size-full object-cover opacity-60 grayscale contrast-[0.8]" src={`${base}/geo/map.jpg`} alt="Карта: офисы в Москве и Санкт-Петербурге" width="1304" height="976" loading="lazy" />
        {pins.map((p) => (
          <div class="absolute flex -translate-x-1/2 -translate-y-[6px] flex-col items-center" style={`left:${p.x}%;top:${p.y}%`}>
            <span class="size-3 rounded-full border-2 border-white bg-brand shadow-[0_0_0_6px_color-mix(in_oklch,var(--brand)_18%,transparent)]"></span>
            <span class="mt-2 rounded-lg bg-white px-3 py-1 text-sm leading-5 text-[#2c2c2c] shadow-[0_1px_2px_rgb(0_0_0/0.08)]">{p.t}</span>
          </div>
        ))}
      </div>
      <span class="absolute bottom-2 right-3 text-[10px] leading-4 text-[#878787]">© OpenStreetMap</span>
    </div>
  </div>
</Section>

<style>
  .ct-card { display: flex; flex-direction: column; }
  .ct-v { font-family: var(--font-display); font-weight: 400; letter-spacing: -0.02em; color: #0c0d0f; font-variant-ligatures: none; }
</style>

<script>
  // Копирование почты: адрес в буфер, на секунду — галочка и «Скопировано»
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); } catch { return; }
    const ic = b.querySelector('[data-copy-ic]')!, ok = b.querySelector('[data-copy-ok]')!, msg = b.querySelector('[data-copy-msg]')!;
    ic.classList.add('hidden'); ok.classList.remove('hidden'); msg.classList.remove('hidden');
    setTimeout(() => { ic.classList.remove('hidden'); ok.classList.add('hidden'); msg.classList.add('hidden'); }, 1500);
  }));
</script>
