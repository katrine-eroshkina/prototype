---
/**
 * А · services:children — услуги внутри категории, карточками как на странице «Все услуги» (ServiceCard):
 * светло-серая карточка (surface, скругление 16), название 24/32, строка о результате серым,
 * внизу за линией — «от XX 000 ₽» (у digital — «/мес») и стрелка ↗, при наведении меняется только стрелка.
 */
import Section from '../../Section.astro';
import SectionHead from './SectionHead.astro';
import { ArrowUpRight } from 'lucide-react';
import type { PageCtx } from '@/data/content';
import { url } from '@/lib/url';
import Price from './Price.astro';
interface Props { ctx: PageCtx }
const { ctx } = Astro.props;
const items = ctx.children ?? [];
const cards = items.length ? items : [1, 2, 3].map(() => ({ href: '', title: 'Услуга категории' }));
const monthly = ctx.direction === 'digital';
---
<Section id="services" variant="children">
  <SectionHead eyebrow="Услуги">Что входит в направление</SectionHead>
  <div class="mt-12 grid auto-rows-fr gap-3 md:grid-cols-2 xl:grid-cols-3">
    {cards.map((s) => {
      const Tag = s.href ? 'a' : 'div';
      return (
        <Tag href={s.href ? url(s.href) : undefined} class="ch-card flex min-h-56 flex-col rounded-2xl bg-surface p-5">
          <h3 class="t-h4 text-fg">{s.title}</h3>
          <p class="mt-1 text-base leading-6 text-fg-muted">Результат услуги в одной строке</p>
          <div class="mt-auto pt-6">
            <div class="flex items-center justify-between border-t border-stroke pt-4">
              <Price per={monthly ? '/мес' : undefined} />
              <ArrowUpRight size={24} strokeWidth={1.75} className="ch-arrow shrink-0" aria-hidden="true" />
            </div>
          </div>
        </Tag>
      );
    })}
  </div>
</Section>

<style>
  .ch-arrow { color: var(--fg); transition: color .2s, transform .2s; }
  .ch-card:is(:hover, :focus-visible) .ch-arrow { color: var(--brand); transform: translate(2px, -2px); }
</style>
