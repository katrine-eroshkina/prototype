---
/**
 * А · служебный экран — 404 и «Спасибо за заявку» (вместо hero:page; формы под ним нет).
 * Карточка со скруглением 16 на фоне формы заявки (HeroBg: размытые полосы и зерно), по центру:
 *  404 — крупное «404» шрифтом заголовков, заголовок, пояснение и две кнопки: «На главную» и «Услуги» (вторичная);
 *  «Спасибо» — чёрный кружок с галочкой, заголовок, «ответим в течение рабочего дня», мессенджеры (как в «Контактах»)
 *  и две кнопки: «Смотреть кейсы» и «На главную» (вторичная) — пока ждут ответа.
 */
import Section from '../../Section.astro';
import Btn from './Btn.astro';
import HeroBg from './HeroBg.astro';
import Messenger from '@/components/icons/Messenger.astro';
import { ArrowUpRight, Check } from 'lucide-react';
import { url } from '@/lib/url';
import type { PageCtx } from '@/data/content';
interface Props { ctx: PageCtx }
const { ctx } = Astro.props;
const thanks = ctx.title.startsWith('Спасибо');
// Ссылки — заглушки, ждём от заказчика
const messengers = [
  { t: 'Telegram', icon: 'telegram' as const, href: 'https://t.me/' },
  { t: 'MAX', icon: 'max' as const, href: '#' },
  { t: 'WhatsApp', icon: 'whatsapp' as const, href: 'https://wa.me/' },
];
---
<Section id="hero" variant="system" class="pt-6 md:pt-8">
  <div class="relative flex min-h-[calc(100svh-180px)] items-center justify-center overflow-hidden rounded-2xl px-6 py-16 md:min-h-[560px]">
    <HeroBg word={false} fade={false} light={false} />
    <div class="relative flex max-w-[560px] flex-col items-center text-center">
      {thanks ? (
        <span class="grid size-14 place-items-center rounded-full bg-fg text-page"><Check size={28} strokeWidth={2} /></span>
      ) : (
        <p class="t-display text-fg">404</p>
      )}
      <h1 class="t-h1 mt-6 text-balance text-fg">{thanks ? 'Спасибо, заявка у нас' : 'Такой страницы нет'}</h1>
      <p class="mt-3 text-base leading-6 text-fg">
        {thanks
          ? 'Ответим в течение рабочего дня. Если срочно — напишите в мессенджер'
          : 'Возможно, ссылка устарела или в адресе опечатка. Начните с главной или посмотрите услуги'}
      </p>
      {thanks && (
        <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2">
          {messengers.map((m) => (
            <a class="t-body group flex h-8 items-center gap-2 text-fg" href={m.href} target="_blank" rel="noopener">
              <Messenger name={m.icon} size={20} mono /><span class="roll"><span>{m.t}</span><span aria-hidden="true">{m.t}</span></span><ArrowUpRight size={14} strokeWidth={2} className="-ml-1 text-fg/60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </a>
          ))}
        </div>
      )}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {thanks ? (
          <>
            <Btn href={url('/keisy/')}>Смотреть кейсы</Btn>
            <Btn href={url('/')} variant="outline">На главную</Btn>
          </>
        ) : (
          <>
            <Btn href={url('/')}>На главную</Btn>
            <Btn href={url('/uslugi/')} variant="outline">Услуги</Btn>
          </>
        )}
      </div>
    </div>
  </div>
</Section>

