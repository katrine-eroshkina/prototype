---
/**
 * А · people:expert — слово основателя, сетка как у блоков главной (1fr / 1.4fr).
 * Слева фото (скругление 16; пока то же стоковое, что у основателя в «Команде»), имя и роль.
 * Справа мини-заголовок «/ Слово основателя», цитата шрифтом заголовков, абзац серым, регалии с синими галочками в две колонки
 * карточка книги основателя и «Написать лично» — мессенджеры чёрными иконками без подложки, как в «Контактах». Тексты — заглушки.
 * Книга — светло-серая карточка (скругление 16): обложка 2:3, подпись «Книга основателя», название, одна строка о книге
 * и две внешние ссылки «Печатная ↗» / «Аудиокнига ↗» (как ссылки мессенджеров, открываются в новой вкладке).
 */
import Section from '../../Section.astro';
import Eyebrow from './Eyebrow.astro';
import Messenger from '@/components/icons/Messenger.astro';
import { ArrowUpRight, Check, BookOpen, Headphones } from 'lucide-react';
import type { PageCtx } from '@/data/content';
interface Props { ctx: PageCtx }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const creds = ['XX лет в маркетинге', 'XXX проектов в B2B и B2C', 'Спикер отраслевых конференций', 'Сертификаты Яндекса и VK'];
// Ссылки — заглушки, ждём от заказчика
const messengers = [
  { t: 'Telegram', icon: 'telegram' as const, href: 'https://t.me/' },
  { t: 'MAX', icon: 'max' as const, href: '#' },
];
// Книга основателя: обложка, название и ссылки — заглушки, ждём от заказчика
const book = {
  title: 'Название книги',
  about: 'Одна строка о том, чему учит книга',
  cover: '',
  links: [
    { t: 'Печатная', icon: BookOpen, href: '#' },
    { t: 'Аудиокнига', icon: Headphones, href: '#' },
  ],
};
---
<Section id="people" variant="expert">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
    <div>
      <img class="aspect-[4/5] w-full max-w-[440px] rounded-2xl bg-surface object-cover" src={`${base}/team/1.jpg`} alt="" loading="lazy" width="640" height="800" />
      <p class="t-body mt-4 text-fg">Андрей Соколов</p>
      <p class="text-sm leading-5 text-fg-muted">Основатель burkov/agency</p>
    </div>
    <div class="lg:self-center">
      <Eyebrow>Слово основателя</Eyebrow>
      <blockquote class="t-h3 mt-4 text-balance text-fg">«Зачем мы существуем и чем отличаемся — 2–3 предложения от первого лица»</blockquote>
      <p class="mt-4 max-w-[560px] text-base leading-6 text-fg-muted">Короткий абзац: как пришёл в маркетинг, почему собрал команду и за что отвечает лично</p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {creds.map((c) => (
          <li class="flex gap-3 text-base leading-6 text-fg"><span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-brand text-fg-inverse" aria-hidden="true"><Check size={12} strokeWidth={3} /></span>{c}</li>
        ))}
      </ul>
      <div class="mt-10 flex gap-4 rounded-2xl bg-surface p-4 md:gap-6 md:p-6">
        {book.cover
          ? <img class="aspect-[2/3] w-20 shrink-0 rounded-[4px] object-cover shadow-[0_4px_12px_rgb(44_44_44/0.12)] md:w-24" src={book.cover} alt={`Обложка книги «${book.title}»`} loading="lazy" />
          : <span class="grid aspect-[2/3] w-20 shrink-0 place-items-center rounded-[4px] bg-stroke text-fg-muted shadow-[0_4px_12px_rgb(44_44_44/0.12)] md:w-24" aria-hidden="true"><BookOpen size={24} strokeWidth={1.5} /></span>}
        <div class="flex min-w-0 flex-col">
          <p class="text-sm leading-5 text-fg-muted">Книга основателя</p>
          <p class="t-h5 mt-1 text-fg">{book.title}</p>
          <p class="mt-1 text-base leading-6 text-fg-muted">{book.about}</p>
          <div class="mt-auto flex flex-wrap gap-x-6 gap-y-1 pt-3">
            {book.links.map((l) => (
              <a class="t-body group flex h-8 items-center gap-2 text-fg" href={l.href} target="_blank" rel="noopener">
                <l.icon size={20} strokeWidth={1.75} /><span class="roll"><span>{l.t}</span><span aria-hidden="true">{l.t}</span></span><ArrowUpRight size={14} strokeWidth={2} className="-ml-1 text-fg-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </a>
            ))}
          </div>
        </div>
      </div>
      <p class="mt-10 text-sm leading-5 text-fg-muted">Написать лично</p>
      <div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
        {messengers.map((m) => (
          <a class="t-body group flex h-8 items-center gap-2 text-fg" href={m.href} target="_blank" rel="noopener">
            <Messenger name={m.icon} size={20} mono /><span class="roll"><span>{m.t}</span><span aria-hidden="true">{m.t}</span></span><ArrowUpRight size={14} strokeWidth={2} className="-ml-1 text-fg-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
          </a>
        ))}
      </div>
    </div>
  </div>
</Section>

