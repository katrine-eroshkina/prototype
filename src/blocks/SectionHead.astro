---
/**
 * Заголовок блока, единый для всех: метка ■, крупный тонкий заголовок слева,
 * лид и ссылка — справа (как «Success Stories» у Thrad).
 */
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { url } from '@/lib/url';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  action?: { href: string; label: string };
  center?: boolean;
  class?: string;
}
const { eyebrow, title, lead, action, center, class: className } = Astro.props;
---
{center ? (
  <div class={cn('mx-auto mb-12 max-w-3xl text-center md:mb-16', className)}>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h2 class="display mt-4 text-4xl md:text-5xl">{title}</h2>
    {lead && <p class="mt-5 text-lg text-muted-foreground text-pretty">{lead}</p>}
  </div>
) : (
  <div class={cn('mb-12 grid gap-6 md:mb-16 lg:grid-cols-[1.4fr_1fr] lg:items-end lg:gap-16', className)}>
    <div>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 class="display mt-4 text-4xl md:text-5xl lg:text-[3.5rem] lg:leading-[1.05]">{title}</h2>
    </div>
    {(lead || action) && (
      <div class="flex flex-col items-start gap-6 lg:pb-2">
        {lead && <p class="text-pretty text-muted-foreground md:text-lg">{lead}</p>}
        {action && <a class={cn(buttonVariants({ variant: 'outline' }), 'h-10 px-5')} href={url(action.href)}>{action.label} <span aria-hidden="true">→</span></a>}
      </div>
    )}
  </div>
)}
