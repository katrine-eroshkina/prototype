---
/**
 * Обёртка блока: фон на всю ширину, контейнер, метка «блок:вариант».
 * Тема: light — фон страницы, alt — приглушённый, dark — включает тёмные токены shadcn (.dark).
 * Якорь — «блок-вариант» (например, #cta-form).
 */
import { cn } from '@/lib/utils';

export type Theme = 'light' | 'alt' | 'dark';

interface Props { id: string; variant?: string; theme?: Theme; class?: string }
const { id, variant, theme = 'light', class: className } = Astro.props;
const tag = variant ? `${id}:${variant}` : id;
const anchor = variant ? `${id}-${variant}` : id;
---
<section
  id={anchor}
  data-block={tag}
  class={cn(
    'relative scroll-mt-16 py-16 md:py-24',
    theme === 'alt' && 'bg-muted/60',
    theme === 'dark' && 'dark bg-background text-foreground',
    className,
  )}
>
  <span class="absolute left-2 top-2 rounded border bg-background/80 px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">{tag}</span>
  <div class="container-x">
    <slot />
  </div>
</section>
