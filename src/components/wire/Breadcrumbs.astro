---
import { url } from '@/lib/url';

interface Props { items: { href?: string; title: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Хлебные крошки" class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
  <a class="hover:text-foreground" href={url('/')}>Главная</a>
  {items.map((item) => (
    <>
      <span aria-hidden="true">/</span>
      {item.href ? <a class="hover:text-foreground" href={url(item.href)}>{item.title}</a> : <span class="text-foreground">{item.title}</span>}
    </>
  ))}
</nav>
