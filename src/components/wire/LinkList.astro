---
/** Список ссылок на дочерние страницы — чтобы по прототипу можно было ходить */
import { url } from '../../lib/url';

interface Props { title?: string; items: { href: string; title: string; draft?: boolean }[] }
const { title = 'Дочерние страницы', items } = Astro.props;
---
<div class="links">
  <strong>{title}</strong>
  <ul>
    {items.map((item) => (
      <li>
        <a href={url(item.href)}>{item.title}</a>
        {item.draft && <em> · пример, ждём перечень от заказчика</em>}
      </li>
    ))}
  </ul>
</div>

<style>
  .links { margin-top: var(--space-4); padding: var(--space-4) var(--space-6); border-radius: var(--radius); background: var(--color-note); font-size: var(--text-sm); }
  ul { margin: var(--space-2) 0 0; padding-left: var(--space-6); columns: 2 240px; }
  em { color: var(--color-draft); font-style: normal; }
</style>
