---
/** Плашка блока, у которого ещё нет компонента */
import { blockInfo } from '@/data/recipes';

interface Props { id: string }
const { id } = Astro.props;
---
<section class="my-4 flex min-h-40 flex-col justify-center gap-2 rounded-xl border border-dashed bg-muted/40 p-6 text-muted-foreground" data-block={id}>
  <code class="font-mono text-sm text-foreground">{id}</code>
  <span>{blockInfo[id] ?? '—'}</span>
</section>
