---
/**
 * Шапка + меню услуг.
 * Десктоп (≥1024px): мега-панель «всё открыто» (как Kokoc, Mosseo, Siege):
 *   Консалтинг — 1 колонка, Digital — 3; категория = заголовок-ссылка + её услуги.
 * Мобильные: полноэкранное меню с пошаговым переходом: Меню → Услуги → категория.
 */
import { buttonVariants } from '@/components/ui/button';
import { groups, mainNav, catUrl, serviceUrl } from '@/data/sitemap';
import { cn } from '@/lib/utils';
import { url } from '@/lib/url';

const navRest = mainNav.filter((i) => i.href !== '/uslugi/');
const allCats = groups.flatMap((g) => g.categories);
const navLink = 'text-sm text-muted-foreground transition hover:text-foreground';
const mItem = 'flex w-full items-center justify-between border-b py-3.5 text-left text-xl font-semibold';
---
<header class="sticky top-0 z-50 border-b bg-background" data-header>
  <!-- Логотип слева · меню по центру · телефон и кнопка справа -->
  <div class="container-x flex h-16 items-center gap-8 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a class="justify-self-start whitespace-nowrap text-lg font-extrabold tracking-tight" href={url('/')}>burkov<span class="text-muted-foreground">/</span><span class="font-normal text-muted-foreground">agency</span></a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Основное меню">
      <button class={cn(navLink, 'flex items-center gap-1 aria-expanded:text-foreground')} type="button" aria-expanded="false" aria-controls="mega" data-mega-toggle>
        Услуги <svg class="size-3.5 transition [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
      {navRest.map((item) => (
        <a class={navLink} href={url(item.href)}>{item.title}{item.draft && <sup class="ml-0.5 text-draft" title="Под вопросом">(?)</sup>}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-4 lg:ml-0 lg:justify-self-end">
      <!-- Телефон вместо переключателя языков; язык — в подвале (EN, вероятно, отдельный сайт) -->
      <a class="hidden whitespace-nowrap text-sm font-medium xl:inline" href="tel:+70000000000">+7 (XXX) XXX-XX-XX</a>
      <a class={cn(buttonVariants({ size: 'sm' }), 'hidden sm:inline-flex')} href={url('/kontakty/')}>Обсудить</a>
      <button class={cn(buttonVariants({ variant: 'outline', size: 'icon' }), 'lg:hidden')} type="button" aria-expanded="false" aria-controls="mnav" aria-label="Меню" data-mnav-toggle>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>

  <!-- ===== Десктоп: мега-панель ===== -->
  <div class="absolute inset-x-0 top-full hidden border-b bg-background shadow-lg lg:block" id="mega" hidden data-mega>
    <div class="container-x grid grid-cols-[repeat(2,minmax(0,320px))] gap-16 py-8">
      {groups.map((g) => (
        <section>
          <a class="block border-b pb-3 text-xs font-medium uppercase tracking-wider text-muted-foreground hover:text-foreground" href={url(`/uslugi/#${g.slug}`)}>{g.title}</a>
          {/* Обе группы одинаково, одним столбиком: категория — жирный заголовок, под ним её услуги */}
          <div class="mt-5 grid content-start gap-y-4">
            {g.categories.map((c) => (
              <div>
                <a class="font-semibold hover:underline" href={url(catUrl(c))}>{c.title}</a>
                {c.children.length > 0 && (
                  <ul class="mt-2 mb-2 grid gap-1.5 text-sm">
                    {c.children.map((s) => <li><a class="text-muted-foreground hover:text-foreground" href={url(serviceUrl(c, s))}>{s.title}</a></li>)}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div class="border-t">
      <div class="container-x py-4 text-sm"><a class="font-medium hover:underline" href={url('/uslugi/')}>Все услуги →</a></div>
    </div>
  </div>

  <!-- ===== Мобильные: drill-down ===== -->
  <div class="fixed inset-x-0 bottom-0 top-16 overflow-y-auto bg-background lg:hidden" id="mnav" hidden data-mnav>
    <div class="container-x">
      <button class="mt-4 text-sm text-muted-foreground" type="button" data-mnav-back hidden>← <span data-mnav-title></span></button>
      <p class="mt-3 text-3xl font-semibold tracking-tight" data-mnav-current hidden></p>
    </div>

    <div class="container-x flex flex-col pb-12 pt-2" data-level="root">
      <button class={mItem} type="button" data-go="services">Услуги <span class="text-muted-foreground">›</span></button>
      {navRest.map((item) => (
        <a class={mItem} href={url(item.href)}><span>{item.title}{item.draft && <sup class="ml-1 text-sm text-draft">(?)</sup>}</span></a>
      ))}
      <div class="mt-8 flex flex-col items-start gap-3 text-sm text-muted-foreground">
        <a class={buttonVariants({ size: 'lg' })} href={url('/kontakty/')}>Обсудить задачу</a>
        <a class="text-base font-medium text-foreground" href="tel:+70000000000">+7 (XXX) XXX-XX-XX</a>
        <span>Telegram · MAX</span>
        <a class="underline underline-offset-4" href="#">English version</a>
      </div>
    </div>

    <div class="container-x flex flex-col pb-12 pt-2" data-level="services" data-title="Услуги" hidden>
      <a class={cn(mItem, 'text-base font-medium text-muted-foreground')} href={url('/uslugi/')}>Все услуги</a>
      {groups.map((g) => (
        <>
          <span class="mt-6 text-xs font-medium uppercase tracking-wider text-muted-foreground">{g.title}</span>
          {g.categories.map((c) => c.children.length
            ? <button class={mItem} type="button" data-go={`cat-${c.slug}`}>{c.title} <span class="text-muted-foreground">›</span></button>
            : <a class={mItem} href={url(catUrl(c))}>{c.title}</a>)}
        </>
      ))}
    </div>

    {allCats.filter((c) => c.children.length).map((c) => (
      <div class="container-x flex flex-col pb-12 pt-2" data-level={`cat-${c.slug}`} data-title={c.title} hidden>
        <a class={cn(mItem, 'text-base font-medium text-muted-foreground')} href={url(catUrl(c))}>Всё о направлении</a>
        {c.children.map((s) => <a class={mItem} href={url(serviceUrl(c, s))}>{s.title}</a>)}
      </div>
    ))}
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  /* ---------- Мега-панель ---------- */
  const toggle = header.querySelector<HTMLButtonElement>('[data-mega-toggle]')!;
  const mega = header.querySelector<HTMLElement>('[data-mega]')!;
  const setMega = (open: boolean) => {
    mega.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () => setMega(mega.hidden));
  document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) setMega(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !mega.hidden) { setMega(false); toggle.focus(); }
  });

  /* ---------- Мобильное меню ---------- */
  const burger = header.querySelector<HTMLButtonElement>('[data-mnav-toggle]')!;
  const mnav = header.querySelector<HTMLElement>('[data-mnav]')!;
  const back = header.querySelector<HTMLButtonElement>('[data-mnav-back]')!;
  const backTitle = header.querySelector<HTMLElement>('[data-mnav-title]')!;
  const currentTitle = header.querySelector<HTMLElement>('[data-mnav-current]')!;
  const panels = header.querySelectorAll<HTMLElement>('[data-level]');
  const stack: string[] = ['root'];

  const render = () => {
    const current = stack[stack.length - 1];
    panels.forEach((p) => (p.hidden = p.dataset.level !== current));
    const parent = stack[stack.length - 2];
    back.hidden = !parent;
    const parentPanel = header.querySelector<HTMLElement>(`[data-level="${parent}"]`);
    backTitle.textContent = parentPanel?.dataset.title ?? 'Меню';
    const currentPanel = header.querySelector<HTMLElement>(`[data-level="${current}"]`);
    currentTitle.textContent = currentPanel?.dataset.title ?? '';
    currentTitle.hidden = !currentPanel?.dataset.title;
  };
  const setMnav = (open: boolean) => {
    mnav.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) { stack.splice(1); render(); }
  };
  burger.addEventListener('click', () => setMnav(mnav.hidden));
  header.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
    b.addEventListener('click', () => { stack.push(b.dataset.go!); render(); }),
  );
  back.addEventListener('click', () => { stack.pop(); render(); });

  // Для показа и проверки: ?open=mega — мега-панель, ?open=mnav[&level=cat-seo] — мобильное меню
  const params = new URLSearchParams(location.search);
  if (params.get('open') === 'mega') setMega(true);
  if (params.get('open') === 'mnav') {
    setMnav(true);
    const level = params.get('level') ?? '';
    if (level === 'services') stack.push('services');
    if (level.startsWith('cat-')) stack.push('services', level);
    render();
  }
</script>
