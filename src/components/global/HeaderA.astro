---
/**
 * Шапка версии А.
 * Плашка — по Direct (wearedirect.co/work), но белая: плавающая, с отступами от краёв и скруглением, мягкая тень и тонкая обводка,
 *   логотип слева (синий слэш), меню чёрным по центру, справа чёрная кнопка + квадрат со стрелкой.
 *   При прокрутке вниз прячется, при прокрутке вверх возвращается.
 * Раскрытие «Услуг» — по Wonderful (wonderful.ai), в белой плашке:
 *   колонки «название + короткое описание», справа карточка кейса; открывается при наведении.
 * Десктоп (от 1024px) — «три острова»: логотип без фона слева, меню — стеклянная капсула по центру, телефон и кнопка справа;
 *   между ними видна страница. После прокрутки телефон прячется. «Услуги» раскрываются белой панелью под капсулой, страница под ней слегка размывается.
 * Логотип: «agency» печатается при первом заходе (один раз за визит), курсор цвета бренда гаснет.
 * Мобильные: плашка с бургером; меню на весь экран, внизу закреплены «Обсудить задачу» (основная без стрелки, на всю ширину) и телефон — вторичная кнопка с обводкой (иконка + номер, звонит по нажатию).
 */
import { groups, mainNav, catUrl } from '@/data/sitemap';
import { categoryCard } from '@/data/content';
import { url } from '@/lib/url';
import MoreLink from '../../blocks/versions/a/MoreLink.astro';
import Btn from '../../blocks/versions/a/Btn.astro';

const navRest = mainNav.filter((i) => i.href !== '/uslugi/');
const [konsalting, digital] = groups;
const half = Math.ceil(digital.categories.length / 2);
const digitalCols = [digital.categories.slice(0, half), digital.categories.slice(half)];
const item = 'group/i block rounded-md py-3';
/** Описания в меню — без точки в конце */
const noDot = (s?: string) => s?.replace(/\.$/, '');
---
<header class="hdr-a fixed inset-x-0 top-0 z-50 border-b border-transparent px-3 py-2.5 sm:px-5" data-ha>
  <!-- Под раскрытым меню «Услуги» страница слегка размывается; клик по ней закрывает меню -->
  <div class="ha-scrim" aria-hidden="true" data-ha-scrim></div>
  <div class="ha-bar relative rounded-md bg-page text-fg shadow-[0_0_0_1px_var(--hairline),0_4px_16px_var(--hairline)]" data-ha-bar>
    <div class="ha-row grid h-11 grid-cols-[1fr_auto] items-center px-3 lg:grid-cols-[1fr_auto_1fr]">
      <a class="ha-logo justify-self-start whitespace-nowrap text-lg font-extrabold tracking-tight" href={url('/')}>burkov<span class="ha-slash text-brand">/</span><span class="font-normal">agency</span></a>

      <nav class="ha-nav hidden items-center gap-7 text-sm font-medium lg:flex" aria-label="Основное меню">
        <button type="button" class="flex items-center gap-1" aria-expanded="false" aria-controls="ha-mega" data-ha-toggle>
          <span class="roll"><span>Услуги</span><span aria-hidden="true">Услуги</span></span> <svg class="size-3.5 transition [[aria-expanded=true]>&]:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        {navRest.map((i) => (
          <a href={url(i.href)}><span class="roll"><span>{i.title}</span><span aria-hidden="true">{i.title}</span></span>{i.draft && <sup class="ml-0.5 text-fg-muted" title="Под вопросом">(?)</sup>}</a>
        ))}
      </nav>

      <div class="flex items-center gap-1 justify-self-end">
        <a class="ha-tel mr-3 hidden whitespace-nowrap text-sm text-fg xl:inline" href="tel:+70000000000">+7 XXX XXX-XX-XX</a>
        <a class="ha-btn ha-cta hidden h-[30px] items-center rounded-[5px] bg-action px-3 text-sm font-medium text-on-action transition sm:inline-flex" href={url('/kontakty/')} data-lead=""><span class="roll"><span>Обсудить задачу</span><span aria-hidden="true">Обсудить задачу</span></span></a>
        <a class="ha-btn ha-icon hidden size-[30px] place-items-center rounded-[5px] bg-action text-on-action transition sm:grid" href={url('/kontakty/')} aria-label="Связаться" data-lead="">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 14.5l5-5M10 9.5h4.5V14"/></svg>
        </a>
        <button type="button" class="ha-burger -mr-1 grid size-[32px] place-items-center text-fg lg:hidden" aria-expanded="false" aria-controls="ha-mob" aria-label="Меню" data-ha-burger>
          <svg class="ha-burger-open size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
          <svg class="ha-burger-close size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>

    <!-- ===== Раскрытие «Услуг» (Wonderful, в белом) ===== -->
    <div class="ha-mega" id="ha-mega" data-ha-mega>
      <div><div class="grid grid-cols-[1fr_2fr_minmax(0,320px)] gap-x-16 border-t border-stroke px-6 pb-9 pt-8">
        <!-- Колонка консалтинга: «Все услуги» прижата к низу — на уровне последнего описания в Digital -->
        <div class="flex flex-col">
          <p class="mb-3 text-sm text-fg-muted">{konsalting.title}</p>
          {konsalting.categories.map((c, k) => (
            <a class={item} href={url(catUrl(c))} style={`--d:${k}`}>
              <span class="block text-base font-normal text-fg"><span class="roll"><span>{c.title}</span><span aria-hidden="true">{c.title}</span></span></span>
              <span class="mt-1 block text-sm font-normal text-fg-muted">{noDot(categoryCard[c.slug]?.what)}</span>
            </a>
          ))}
          <!-- pb-3 = нижний отступ пункта: низ ссылки совпадает с низом текста описания -->
          <MoreLink class="mt-auto self-start pb-3 leading-5" href={url('/uslugi/')} style="--d:9">Все услуги</MoreLink>
        </div>
        <div>
          <p class="mb-3 text-sm text-fg-muted">{digital.title}</p>
          <div class="grid grid-cols-2 gap-x-16">
            {digitalCols.map((col, ci) => (
              <div>
                {col.map((c, k) => (
                  <a class={item} href={url(catUrl(c))} style={`--d:${k + ci * 2 + 2}`}>
                    <span class="block text-base font-normal text-fg"><span class="roll"><span>{c.title}</span><span aria-hidden="true">{c.title}</span></span></span>
                    <span class="mt-1 block text-sm font-normal text-fg-muted">{noDot(categoryCard[c.slug]?.what)}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
        <!-- Карточка кейса справа -->
        <a class="group/c self-start" href={url('/keisy/primer-seo/')}>
          <span class="grid aspect-[16/10] place-items-center overflow-hidden rounded-md bg-[linear-gradient(160deg,oklch(0.45_0.08_240),oklch(0.3_0.05_250))] text-xs text-fg-muted">обложка кейса</span>
          <span class="mt-3 block text-base font-normal leading-snug text-fg">Как производитель получил в 3 раза больше заявок из поиска за 8 месяцев</span>
          <MoreLink as="span" class="mt-2 inline-block">Читать кейс</MoreLink>
        </a>
      </div></div>
    </div>

    <!-- ===== Мобильное меню ===== -->
    <div class="ha-mob overscroll-contain px-3 pt-4 lg:hidden" id="ha-mob" hidden data-ha-mob data-lenis-prevent>
      <details class="py-3">
        <summary class="flex cursor-pointer list-none items-center justify-between t-h5">Услуги <svg class="ha-mob-chev size-6 text-fg transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        {groups.map((g) => (
          <div class="mt-4">
            <p class="text-sm text-fg-muted">{g.title}</p>
            {g.categories.map((c) => <a class="block py-2 font-normal text-fg" href={url(catUrl(c))}>{c.title}</a>)}
          </div>
        ))}
        <MoreLink class="mt-2 inline-block py-2" href={url('/uslugi/')}>Все услуги</MoreLink>
      </details>
      {navRest.map((i) => <a class="t-h5 block py-3" href={url(i.href)}>{i.title}{i.draft && <sup class="ml-1 text-sm text-fg-muted">(?)</sup>}</a>)}
      <!-- Действия прижаты к низу экрана (зона большого пальца) и не уезжают, когда список «Услуг» прокручивается -->
      <div class="ha-mob-actions sticky bottom-0 mt-auto flex flex-col gap-2 bg-page pb-[max(16px,env(safe-area-inset-bottom))] pt-6">
        <Btn full noIcon href={url('/kontakty/')} data-lead="">Обсудить задачу</Btn>
        <Btn full variant="outline" href="tel:+70000000000" aria-label="Позвонить: +7 XXX XXX-XX-XX"><svg class="mr-2 inline size-4 align-[-3px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>+7 XXX XXX-XX-XX</Btn>
      </div>
    </div>
  </div>
</header>

<style>
  /* Кнопка «Обсудить задачу» + иконка — как кнопки на страницах: при наведении на любую часть иконка поворачивается, обе плашки светлеют */
  .ha-icon svg { transition: transform .2s ease; }
  .ha-cta:hover + .ha-icon svg, .ha-icon:hover svg { transform: rotate(45deg); }
  /* наведение на квадрат со стрелкой тоже перекатывает текст кнопки */
  .ha-cta:has(+ .ha-icon:hover) .roll > :first-child { transform: translateY(-105%); }
  .ha-cta:has(+ .ha-icon:hover) .roll > :last-child { transform: none; }
  /* «Услуги» в мобильном меню: шеврон вниз, как на десктопе; в раскрытом виде переворачивается */
  .ha-mob summary::-webkit-details-marker { display: none; }
  .ha-mob details[open] .ha-mob-chev { transform: rotate(180deg); }
  /* Бургер: в открытом меню вместо полосок — крестик */
  .ha-burger-close, [aria-expanded="true"] > .ha-burger-open { display: none; }
  [aria-expanded="true"] > .ha-burger-close { display: block; }
  /* Мобильное меню на весь экран: шапка растягивается до низа, фон страницы, меню прокручивается внутри, сайт под ним не прокручивается */
  @media (max-width: 1023px) {
    /* двойной [data-mob] — сильнее правила стекла после прокрутки ([data-ha][data-scrolled]) */
    [data-ha][data-mob][data-mob] { bottom: 0; display: flex; flex-direction: column; background: var(--page); -webkit-backdrop-filter: none; backdrop-filter: none; }
    [data-ha][data-mob] .ha-bar { flex: 1; min-height: 0; display: flex; flex-direction: column; box-shadow: none; }
    [data-ha][data-mob] .ha-mob { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; }
    [data-ha][data-mob] .ha-mob > * { flex-shrink: 0; }
    /* над кнопками — мягкое затухание, когда длинный список уходит под них */
    .ha-mob-actions::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 24px; pointer-events: none; background: linear-gradient(transparent, var(--page)); }
    /* кнопка «Наверх» не висит поверх меню */
    :global(html.ha-mob-open .to-top) { display: none; }
  }
  /* Раскрытие: плавно, пункты появляются лесенкой (как у Wonderful) */
  .ha-mega { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s cubic-bezier(.2,.7,.2,1); }
  .ha-mega > div { min-height: 0; overflow: hidden; }
  .ha-mega a, .ha-mega p { opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .25s; }
  [data-ha][data-open] .ha-mega { grid-template-rows: 1fr; }
  [data-ha][data-open] .ha-mega a, [data-ha][data-open] .ha-mega p { opacity: 1; transform: none; transition-delay: calc(80ms + var(--d, 0) * 35ms); }
  @media (max-width: 1023px) { .ha-mega { display: none; } }

  /* Плавное появление стекла после прокрутки */
  [data-ha] { transition: background-color .2s cubic-bezier(0,0,.2,1), border-color .2s, box-shadow .2s; }
  .ha-bar, .ha-bar .ha-dim, .ha-bar .ha-btn { transition: background-color .2s cubic-bezier(0,0,.2,1), color .2s, box-shadow .2s; }
  /* Пункты меню — цвет задан явно и меняется одновременно с плашкой (если наследовать цвет, ссылки на миг остаются белыми на белом) */
  .ha-bar nav > * { color: var(--fg); transition: color .2s cubic-bezier(0,0,.2,1); }
  /* После прокрутки белая плавающая шапка не меняется: за ней (во всю ширину, с полями вокруг плашки) — полоса размытого стекла,
     чтобы содержимое страницы не просвечивало вокруг шапки. Шапка не перекрашивается — меню «Услуги» всегда открывается в той же белой плашке. */
  [data-ha][data-scrolled] {
    background: var(--glass); -webkit-backdrop-filter: blur(12px) saturate(1.5); backdrop-filter: blur(12px) saturate(1.5); }


  /* Размытие страницы под раскрытым меню */
  .ha-scrim { position: fixed; inset: 0; z-index: -1; background: var(--glass-soft); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    opacity: 0; visibility: hidden; transition: opacity .3s ease, visibility .3s; }
  [data-ha][data-open] .ha-scrim { opacity: 1; visibility: visible; }

  /* ===== Десктоп: «три острова» ===== */
  @media (min-width: 1024px) {
    /* общая плашка прозрачная — видны только острова */
    .ha-bar { background: transparent; box-shadow: none; }
    /* меню — стеклянная капсула */
    .ha-nav { height: 44px; padding-inline: 24px; border-radius: 999px;
      background: var(--glass-strong); -webkit-backdrop-filter: blur(14px) saturate(1.6); backdrop-filter: blur(14px) saturate(1.6);
      box-shadow: 0 0 0 1px var(--hairline), 0 4px 16px var(--hairline); }
    [data-ha][data-scrolled] .ha-tel { display: none; }
    /* полосы стекла на всю ширину нет — между островами видна страница */
    [data-ha][data-scrolled] { background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
    /* раскрытие услуг — белая панель под островами */
    .ha-mega > div > div { margin-top: 8px; border: 0; border-radius: 12px; background: var(--page);
      box-shadow: inset 0 0 0 1px var(--hairline); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ha]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-ha-toggle]')!;
    const mega = root.querySelector<HTMLElement>('[data-ha-mega]')!;
    let timer: number | undefined;
    const setOpen = (open: boolean) => {
      root.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    // Наведение (как у Wonderful) + клик для тачпадов и клавиатуры
    toggle.addEventListener('mouseenter', () => { clearTimeout(timer); setOpen(true); });
    toggle.addEventListener('click', () => setOpen(!root.hasAttribute('data-open')));
    [toggle, mega].forEach((el) => el.addEventListener('mouseleave', () => { timer = window.setTimeout(() => setOpen(false), 180); }));
    mega.addEventListener('mouseenter', () => clearTimeout(timer));
    root.querySelectorAll('nav a').forEach((a) => a.addEventListener('mouseenter', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

    // Мобильное меню
    const burger = root.querySelector<HTMLButtonElement>('[data-ha-burger]')!;
    const mob = root.querySelector<HTMLElement>('[data-ha-mob]')!;
    const lenis = () => (window as any).lenis;
    const setMob = (open: boolean) => {
      mob.hidden = !open;
      root.toggleAttribute('data-mob', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Меню');
      // сайт под меню не прокручивается
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.documentElement.classList.toggle('ha-mob-open', open);
      if (open) lenis()?.stop(); else lenis()?.start();
    };
    burger.addEventListener('click', () => setMob(mob.hidden));
    // переход по пункту, «Обсудить задачу», Esc и переход на десктоп закрывают меню
    mob.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMob(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mob.hidden) setMob(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches && !mob.hidden) setMob(false); });

    // После прокрутки за шапкой появляется полоса размытого стекла
    // Пока шапка над первым экраном главной — data-on-hero (в тёмной теме кнопки там белые, потом обычные)
    const hero = document.querySelector('.hero-a-inner')?.closest('section');
    const onScroll = () => {
      root.toggleAttribute('data-scrolled', scrollY > 20);
      root.toggleAttribute('data-on-hero', !!hero && hero.getBoundingClientRect().bottom > root.offsetHeight);
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });

    // Клик по размытому фону закрывает меню
    root.querySelector('[data-ha-scrim]')?.addEventListener('click', () => setOpen(false));


    // Для показа: ?open=mega
    if (new URLSearchParams(location.search).get('open') === 'mega') setOpen(true);
  }
</script>
