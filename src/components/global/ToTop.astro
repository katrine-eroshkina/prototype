---
/**
 * Кнопка «Наверх» — справа внизу, как плашка-иконка у кнопок А: чёрный квадрат 40, скругление 5, стрелка вверх.
 * Появляется, когда прокрутили больше экрана; по клику — плавно наверх (через Lenis, если запущен).
 * У низа страницы останавливается над линией строки с ИНН/ОГРН в подвале, чтобы не закрывать переключатель «RU».
 */
import { ArrowUp } from 'lucide-react';
---
<button type="button" class="to-top fixed bottom-4 right-4 z-[60] grid size-10 place-items-center rounded-[5px] bg-[#0c0d0f] text-white md:bottom-6 md:right-6" aria-label="Наверх" data-to-top>
  <ArrowUp size={20} strokeWidth={1.75} />
</button>

<style>
  .to-top { opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .25s, transform .25s, visibility .25s; }
  .to-top.is-on { opacity: 1; visibility: visible; transform: none; }
  /* При наведении цвет не меняется — стрелка чуть поднимается */
  .to-top svg { transition: transform .2s ease; }
  .to-top:hover svg { transform: translateY(-2px); }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]')!;
  // Внизу страницы кнопка не опускается ниже линии над строкой с ИНН/ОГРН в подвале — останавливается над ней (зазор 16), не закрывая «RU»
  const legal = document.querySelector<HTMLElement>('.ft-legal');
  const sync = () => {
    btn.classList.toggle('is-on', scrollY > innerHeight);
    if (!legal) return;
    const bottom = parseFloat(getComputedStyle(btn).bottom) || 0;
    const lift = Math.max(0, innerHeight - bottom - (legal.getBoundingClientRect().top - 16));
    btn.style.translate = lift ? `0 ${-lift}px` : '';
  };
  addEventListener('scroll', sync, { passive: true });
  addEventListener('resize', sync);
  sync();
  btn.addEventListener('click', () => {
    const lenis = (window as any).lenis;
    if (lenis) lenis.scrollTo(0); else scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
