<style>
  .footer { margin-top: var(--space-12); border-top: 1px solid var(--color-line); background: var(--color-surface); font-size: var(--text-sm); color: var(--color-text-muted); }
  .footer__inner { display: flex; gap: var(--space-6); flex-wrap: wrap; padding-block: var(--space-8); }
</style>
