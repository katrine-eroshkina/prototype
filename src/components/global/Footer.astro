---
/**
 * Подвал: навигация по разделам и категориям (PDF) + контакты и реквизиты
 * (PDF, «Контакты»: телефон · мессенджеры · реквизиты).
 * Нижняя строка — служебные ссылки прототипа, в итоговый сайт не входят.
 */
import { groups, mainNav, catUrl } from '@/data/sitemap';
import { url } from '@/lib/url';

const link = 'text-muted-foreground hover:text-foreground';
const head = 'ft-head mb-4 block text-xs font-medium uppercase tracking-wider text-muted-foreground';
---
<footer class="dark bg-background text-sm text-foreground">
  <div class="container-x grid gap-10 border-t py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(4,1fr)]">
    <div>
      <a class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight" href={url('/')}><span class="shrink-0" aria-hidden="true"><span class="grid size-7 place-items-center rounded-[5px] bg-foreground text-background"><svg class="size-4" viewBox="0 0 16 16"><path d="M10.5 2.5 5.5 13.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" /></svg></span></span><span>burkov<span class="text-muted-foreground">/</span><span class="font-normal text-muted-foreground">agency</span></span></a>
      <p class="mt-3 max-w-56 text-muted-foreground">Маркетинговое агентство: консалтинг и digital</p>
    </div>

    {groups.map((g) => (
      <nav aria-label={g.title}>
        <a class={head} href={url(`/uslugi/#${g.slug}`)}>{g.title}</a>
        <ul class="grid gap-2.5">{g.categories.map((c) => <li><a class={link} href={url(catUrl(c))}>{c.title}</a></li>)}</ul>
      </nav>
    ))}

    <nav aria-label="Разделы">
      <span class={head}>Разделы</span>
      <ul class="grid gap-2.5">{mainNav.map((i) => <li><a class={link} href={url(i.href)}>{i.title}{i.draft && <sup class="ml-0.5 text-draft">(?)</sup>}</a></li>)}</ul>
    </nav>

    <div>
      <span class={head}>Контакты</span>
      <ul class="grid gap-2.5 text-muted-foreground">
        <li>+7 XXX XXX-XX-XX</li>
        <li>hello@burkov.agency</li>
        <li>Telegram · MAX · WhatsApp</li>
      </ul>
    </div>
  </div>

  <!-- Огромный логотип на всю ширину колонки -->
  <div class="container-x overflow-hidden">
    <p class="ft-word select-none whitespace-nowrap pb-[0.22em] pt-6 text-[clamp(2.5rem,13.3vw,11.4rem)] font-extrabold leading-[0.9] tracking-[-0.05em]" aria-hidden="true">burkov<span class="text-brand">/</span><span class="font-normal text-muted-foreground">agency</span></p>
  </div>

  <!-- Правовая строка: тонкая линия по ширине колонки, пункты разнесены по ширине (как у референса) -->
  <div class="container-x">
    <div class="ft-legal flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5 text-muted-foreground">
      <span>© 2026 ООО «Бурков Агентство»</span>
      <!-- Реквизиты — моковые, заменить на настоящие -->
      <span class="flex gap-4"><span>ИНН 7701234567</span><span>ОГРН 1237700012345</span></span>
      <a class="hover:text-foreground" href={url('/politika/')}>Политика конфиденциальности</a>
      <a class="hover:text-foreground" href={url('/soglasie/')}>Согласие на обработку ПД</a>
      <!-- Переключение языка: шеврон, список открывается вверх. EN, вероятно, отдельный сайт -->
      <details class="ft-lang relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 font-medium text-foreground">RU<svg class="ft-chev size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <ul class="absolute bottom-full right-0 mb-2 min-w-36 rounded-xl border bg-background p-1 shadow-lg">
          <li><span class="flex h-9 items-center rounded-lg px-3 font-medium text-foreground">Русский</span></li>
          <li><a class="flex h-9 items-center rounded-lg px-3 hover:bg-secondary hover:text-foreground" href="#">English</a></li>
        </ul>
      </details>
    </div>
  </div>

</footer>

<style>
  .ft-legal { border-top: 1px solid var(--border); }
  .ft-lang summary::-webkit-details-marker { display: none; }
  .ft-chev { transition: transform .2s; }
  .ft-lang[open] .ft-chev { transform: rotate(180deg); }
</style>

<script>
  // Список языков закрывается по клику вне него
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.ft-lang[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
</script>
