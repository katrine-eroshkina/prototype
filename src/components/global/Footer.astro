---
/**
 * Подвал: навигация по разделам и категориям (PDF) + контакты и реквизиты
 * (PDF, «Контакты»: телефон · мессенджеры · реквизиты).
 * Нижняя строка — служебные ссылки прототипа, в итоговый сайт не входят.
 */
import { groups, mainNav, catUrl } from '@/data/sitemap';
import { url } from '@/lib/url';

const link = 'text-muted-foreground hover:text-foreground';
const head = 'mb-4 block text-xs font-medium uppercase tracking-wider text-muted-foreground';
---
<footer class="border-t text-sm">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(4,1fr)]">
    <div>
      <a class="text-lg font-extrabold tracking-tight" href={url('/')}>burkov<span class="text-muted-foreground">/</span><span class="font-normal text-muted-foreground">agency</span></a>
      <p class="mt-3 max-w-56 text-muted-foreground">Маркетинговое агентство: консалтинг и digital.</p>
    </div>

    {groups.map((g) => (
      <nav aria-label={g.title}>
        <a class={head} href={url(`/uslugi/#${g.slug}`)}>{g.title}</a>
        <ul class="grid gap-2.5">{g.categories.map((c) => <li><a class={link} href={url(catUrl(c))}>{c.title}</a></li>)}</ul>
      </nav>
    ))}

    <nav aria-label="Разделы">
      <span class={head}>Разделы</span>
      <ul class="grid gap-2.5">{mainNav.map((i) => <li><a class={link} href={url(i.href)}>{i.title}{i.draft && <sup class="ml-0.5 text-draft">(?)</sup>}</a></li>)}</ul>
    </nav>

    <div>
      <span class={head}>Контакты</span>
      <ul class="grid gap-2.5 text-muted-foreground">
        <li>+7 (XXX) XXX-XX-XX</li>
        <li>hello@burkov.agency</li>
        <li>Telegram · MAX · WhatsApp</li>
      </ul>
    </div>
  </div>

  <div class="border-t">
    <div class="container-x flex flex-wrap gap-6 py-5 text-muted-foreground">
      <span>© 2026 ООО «…» · ИНН … · ОГРН …</span>
      <a class="hover:text-foreground" href={url('/politika/')}>Политика конфиденциальности</a>
      <!-- Переключение языка: здесь, а не в шапке. EN, вероятно, отдельный сайт -->
      <span class="ml-auto flex items-center gap-2">
        <span class="font-medium text-foreground">RU</span><span aria-hidden="true">·</span><a class="hover:text-foreground" href="#">English version</a>
      </span>
    </div>
  </div>

  <div class="border-t bg-amber-50 font-mono text-[11px] text-muted-foreground">
    <div class="container-x flex flex-wrap gap-4 py-2">
      <span>Прототип:</span>
      <a class="underline" href={url('/blocks/')}>Каталог блоков</a>
      <a class="underline" href={url('/logo/')}>Логотип</a>
    </div>
  </div>
</footer>
