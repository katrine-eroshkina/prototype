---
/**
 * Подвал: навигация по разделам и категориям (PDF) + контакты и реквизиты
 * (PDF, «Контакты»: телефон · мессенджеры · реквизиты).
 * Ссылки при наведении перекатываются (Roll), цвет не меняется.
 */
import { groups, mainNav, catUrl } from '@/data/sitemap';
import { url } from '@/lib/url';
import Roll from '../../blocks/versions/a/Roll.astro';

const link = 'text-muted-foreground';
const head = 'ft-head mb-4 block text-xs font-medium uppercase tracking-wider text-muted-foreground';
---
<footer class="dark bg-background text-sm text-foreground">
  <div class="container-x grid gap-10 border-t py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(4,1fr)]">
    <div>
      <a class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight" href={url('/')}><span class="shrink-0" aria-hidden="true"><span class="grid size-7 place-items-center rounded-[5px] bg-foreground text-background"><svg class="size-4" viewBox="0 0 16 16"><path d="M10.5 2.5 5.5 13.5" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" /></svg></span></span><span>burkov<span class="text-muted-foreground">/</span><span class="font-normal text-muted-foreground">agency</span></span></a>
      <p class="mt-3 max-w-56 text-muted-foreground">Маркетинговое агентство: консалтинг и digital</p>
    </div>

    {groups.map((g) => (
      <nav aria-label={g.title}>
        <a class={head} href={url(`/uslugi/#${g.slug}`)}>{g.title}</a>
        <ul class="grid gap-3">{g.categories.map((c) => <li><a class={link} href={url(catUrl(c))}><Roll>{c.title}</Roll></a></li>)}</ul>
      </nav>
    ))}

    <nav aria-label="Разделы">
      <span class={head}>Разделы</span>
      <ul class="grid gap-3">{mainNav.map((i) => <li><a class={link} href={url(i.href)}><Roll>{i.title}</Roll></a></li>)}</ul>
    </nav>

    <div>
      <span class={head}>Контакты</span>
      <ul class="grid gap-3 text-muted-foreground">
        <li>+7 XXX XXX-XX-XX</li>
        <li>hello@burkov.agency</li>
        <li>Telegram · MAX · WhatsApp</li>
      </ul>
    </div>
  </div>

  <!-- Огромный логотип на всю ширину колонки. Когда он появляется на экране, «agency» печатается, дальше курсор продолжает мигать -->
  <div class="container-x overflow-hidden">
    <p class="ft-word select-none whitespace-nowrap pb-[0.22em] pt-6 text-[clamp(2.5rem,13.3vw,11.4rem)] font-extrabold leading-[0.9] tracking-[-0.05em]" aria-hidden="true">burkov<span class="text-brand">/</span><span class="ft-typed font-normal text-muted-foreground"><span class="ft-ghost">agency</span><span class="ft-live"><span data-ft-type>agency</span><i class="ft-caret"></i></span></span></p>
  </div>

  <!-- Правовая строка: тонкая линия по ширине колонки, пункты разнесены по ширине (как у референса) -->
  <div class="container-x">
    <div class="ft-legal flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5 text-muted-foreground">
      <span>© 2026 ООО «Бурков Агентство»</span>
      <!-- Реквизиты — моковые, заменить на настоящие -->
      <span class="flex gap-4"><span>ИНН 7701234567</span><span>ОГРН 1237700012345</span></span>
      <a href={url('/politika/')}><Roll>Политика конфиденциальности</Roll></a>
      <a href={url('/soglasie/')}><Roll>Согласие на обработку ПД</Roll></a>
    </div>
  </div>

</footer>

<style>
  .ft-legal { border-top: 1px solid var(--border); }
  .ft-typed { display: inline-grid; padding-right: .29em; }
  .ft-typed > * { grid-area: 1 / 1; }
  .ft-ghost { visibility: hidden; }
  .ft-live { position: relative; justify-self: start; }
  .ft-caret { position: absolute; left: 100%; top: .18em; width: .21em; height: .8em; margin-left: .08em; background: var(--brand); opacity: 0; }
  .ft-caret.is-on { opacity: 1; animation: ft-blink 1.1s infinite; }
  @keyframes ft-blink { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0; } }
</style>

<script>
  // Печать «agency» в большом логотипе, когда подвал показался на экране (один раз за загрузку страницы)
  const typed = document.querySelector<HTMLElement>('[data-ft-type]');
  const caret = document.querySelector<HTMLElement>('.ft-caret');
  if (typed && caret && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const word = 'agency';
    typed.textContent = '';
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      let i = 0;
      caret.classList.add('is-on');
      const tick = () => {
        typed.textContent = word.slice(0, ++i);
        if (i < word.length) setTimeout(tick, 110);
      };
      setTimeout(tick, 400);
    }, { threshold: 0.6 });
    io.observe(typed.closest('p')!);
  }
</script>
