  ol.tk-list > li { counter-increment: n; display: grid; grid-template-columns: 32px 1fr; }
  ol.tk-list > li::before { content: '/ ' counter(n, decimal-leading-zero); color: var(--fg-muted); font-size: 14px; }
  ul.tk-list > li { padding-left: 20px; position: relative; }
  ul.tk-list > li::before { content: '/'; position: absolute; left: 0; color: var(--brand); font-weight: 800; }
  .tk-list b { font-weight: 500; }
  .tk code, .tk-table code { font-family: ui-monospace, 'JetBrains Mono', monospace; font-size: .875em; color: var(--fg); background: var(--stroke); border-radius: 4px; padding: 1px 4px; white-space: nowrap; }
