  .tk-sw { display: grid; place-items: end start; width: 64px; height: 64px; padding: 6px 8px; border-radius: 12px; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .06); font-size: 11px; line-height: 1; }
  /* подпись образца читается на любом цвете */
  .tk-sw-l { color: #fff; mix-blend-mode: difference; opacity: .6; }
  .tk-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 14px; line-height: 20px; color: var(--fg); }
  .tk-table th { font-weight: 500; color: var(--fg-muted); padding: 12px 16px 12px 0; border-bottom: 1px solid var(--stroke); }
  .tk-table td { padding: 12px 16px 12px 0; border-bottom: 1px solid var(--stroke); vertical-align: top; }
  .tk-bad { color: #d4380d; font-weight: 500; }
</style>
