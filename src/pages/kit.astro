<script>
  // Форма в ките: кнопка активна только с галочкой
  document.querySelectorAll<HTMLElement>('.kit [data-consent-form]').forEach((f) => {
    const box = f.querySelector<HTMLInputElement>('[data-consent]');
    const btn = f.querySelector<HTMLButtonElement>('[data-consent-submit]');
    if (!box || !btn) return;
    box.addEventListener('change', () => { btn.disabled = !box.checked; });
  });
</script>

