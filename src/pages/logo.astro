---
/**
 * Логотип (этап 4), итерация 3: направление «Слэш».
 * Курсор — анимация части после слэша: в шапке набирает слово один раз и исчезает.
 * Шрифты — Google Fonts с кириллицей; display=block, чтобы ширина не прыгала при подмене шрифта.
 */
import { url } from '../lib/url';

/** Слэш: основа + необязательный «путь» после слэша */
const slash = (size: string, path = '') =>
  `<span class="l-slash ${size}">burkov<b>/</b>${path ? `<em>${path}</em>` : ''}</span>`;

/**
 * Анимированный знак: «agency» печатается после слэша.
 * mode: loop — набор/стирание по кругу (видео, презентации);
 *       fade — один раз набрать, курсор исчезает (шапка).
 * Ширину держит невидимый «призрак» слова + постоянный отступ под курсор;
 * сам курсор позиционирован абсолютно и на ширину не влияет.
 */
const slashTyped = (size: string, mode: 'loop' | 'fade' = 'loop', word = 'agency') =>
  `<span class="l-slash ${size}" aria-label="burkov/${word}">burkov<b>/</b><em class="typed"><span class="typed__ghost">${word}</span><span class="typed__live"><span data-type="${word}" data-mode="${mode}">${mode === 'loop' ? word : ''}</span><i class="caret"></i></span></em></span>`;

const favSlash = `<svg viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#0e0e0e"/><text x="16" y="21.5" text-anchor="middle" font-family="Inter" font-weight="800" font-size="15" letter-spacing="-1" fill="#fff">b<tspan fill="#d6ff3a">/</tspan></text></svg>`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Логотип</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=block"
    />
  </head>
  <body>
    <header class="top">
      <a href={url('/')}>← на сайт</a>
      <span>Этап 4 · логотип · итерация 3 · 18.10.2026</span>
    </header>

    <main>
      <h1>Логотип</h1>

      <section class="concept" id="slash">
        <p class="concept__idea">Слэш работает как путь в адресе: после него естественно встаёт то, <i>что</i> это — агентство или конкретное направление. Логотип превращается в систему.</p>

        <h3>Основной знак</h3>
        <div class="stage">
          <div class="cell cell--light"><Fragment set:html={slash('lg')} /></div>
          <div class="cell cell--dark"><Fragment set:html={slash('lg')} /></div>
        </div>

        <h3>С дескриптором</h3>
        <div class="stage">
          <div class="cell cell--light cell--md"><Fragment set:html={slash('md', 'agency')} /></div>
          <div class="cell cell--light cell--md"><Fragment set:html={slash('md', 'group')} /></div>
        </div>

        <h3>Суббренды направлений</h3>
        <div class="stage">
          <div class="cell cell--dark cell--md"><Fragment set:html={slash('md', 'consulting')} /></div>
          <div class="cell cell--dark cell--md"><Fragment set:html={slash('md', 'digital')} /></div>
        </div>
        <p class="hint">Суббренды — в шапках разделов, на презентациях, в подписях писем. Главный логотип сайта — <code>burkov/agency</code>.</p>

        <h3>Анимация: курсор</h3>
        <p class="hint">Часть после слэша «печатается» курсором. В видео и презентациях — в цикле, как ниже. В шапке сайта — один раз при загрузке: надпись появляется, курсор исчезает (пример в шапке ниже). В статике и при отключённой анимации — обычный <code>burkov/agency</code> без курсора.</p>
        <div class="stage">
          <div class="cell cell--dark"><Fragment set:html={slashTyped('anim')} /></div>
          <div class="cell cell--light"><Fragment set:html={slashTyped('anim')} /></div>
        </div>

        <h3 id="header">В шапке и фавиконке</h3>
        <div class="usage">
          <div class="usage__variants">
            <div class="usage__header">
              <span class="usage__logo"><Fragment set:html={slashTyped('sm', 'fade')} /></span>
              <nav><span>Услуги</span><span>Кейсы</span><span>Цены</span><span>Контакты</span></nav>
              <span class="usage__btn">Обсудить</span>
            </div>
            <button class="usage__replay" type="button" data-replay>↻ Повторить</button>
          </div>
          <div class="usage__fav">
            <span class="fav fav--32"><Fragment set:html={favSlash} /></span>
            <span class="fav fav--16"><Fragment set:html={favSlash} /></span>
            <span class="usage__cap">32 / 16 px</span>
          </div>
        </div>
      </section>

      <p class="note">Шрифт Inter, как на всём сайте: «burkov/» — ExtraBold, часть после слэша — Regular.</p>
    </main>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Шапка: один раз набрать слово, затем курсор плавно исчезает.
      const timers = new WeakMap<HTMLElement, number[]>();
      const typeOnce = (el: HTMLElement) => {
        const word = el.dataset.type ?? '';
        const caret = el.nextElementSibling as HTMLElement | null;
        (timers.get(el) ?? []).forEach(clearTimeout);
        const queue: number[] = [];
        timers.set(el, queue);
        caret?.classList.remove('caret--off');
        if (reduce) { el.textContent = word; caret?.classList.add('caret--off'); return; }
        let i = 0;
        el.textContent = '';
        const tick = () => {
          i += 1;
          el.textContent = word.slice(0, i);
          if (i < word.length) queue.push(setTimeout(tick, 110));
          else queue.push(setTimeout(() => caret?.classList.add('caret--off'), 450));
        };
        queue.push(setTimeout(tick, 600));
      };
      const onceEls = document.querySelectorAll<HTMLElement>('[data-mode="fade"]');
      onceEls.forEach(typeOnce);
      document.querySelector('[data-replay]')?.addEventListener('click', () => onceEls.forEach(typeOnce));

      // Видео / презентации: набрать → подержать → стереть → повторить
      document.querySelectorAll<HTMLElement>('[data-mode="loop"]').forEach((el) => {
        if (reduce) return;
        const word = el.dataset.type ?? '';
        let i = word.length;
        let dir = -1;
        const tick = () => {
          i += dir;
          el.textContent = word.slice(0, i);
          let delay = dir > 0 ? 110 : 55;
          if (i >= word.length) { dir = -1; delay = 3200; }
          if (i <= 0) { dir = 1; delay = 500; }
          setTimeout(tick, delay);
        };
        setTimeout(tick, 2400);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #0e0e0e;
    --paper: #f3f2ee;
    --muted: #6d6b66;
    --line: #dcdad4;
    --lime: #d6ff3a;
    --ultra: #2d2dff;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 16px/1.5 'Inter', system-ui, sans-serif; }
  main { max-width: 1200px; margin: 0 auto; padding: 0 16px 80px; }
  a { color: inherit; }
  code { font: 600 0.92em 'Inter', sans-serif; background: #fff; padding: 1px 6px; border-radius: 4px; }

  .top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; max-width: 1200px; margin: 0 auto; padding: 20px 16px; font-size: 14px; color: var(--muted); }
  h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.05; margin: 24px 0 16px; letter-spacing: -0.02em; }
  h3 { margin: 40px 0 12px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }

  .concept__idea { max-width: 760px; margin: 0; color: #2b2a27; }
  .hint { max-width: 760px; margin: 0 0 12px; font-size: 14px; color: var(--muted); }
  .stage + .hint { margin-top: 12px; }

  .stage { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; }
  .cell { display: grid; place-items: center; min-height: 260px; padding: 32px 16px; border-radius: 16px; overflow: hidden; }
  .cell--md { min-height: 180px; }
  .cell--light { background: #fff; color: var(--ink); }
  .cell--dark { background: var(--ink); color: #fff; }

  .usage { display: flex; gap: 12px; flex-wrap: wrap; }
  .usage__header { flex: 1 1 520px; display: flex; align-items: center; gap: 28px; padding: 14px 20px; background: #fff; border-radius: 12px; font-size: 14px; min-width: 0; }
  .usage__header nav { display: flex; gap: 20px; color: var(--muted); }
  .usage__btn { margin-left: auto; padding: 8px 14px; border-radius: 999px; background: var(--ink); color: #fff; white-space: nowrap; }
  .usage__fav { display: flex; align-items: center; gap: 14px; padding: 14px 20px; background: #fff; border-radius: 12px; }
  .usage__cap { font-size: 12px; color: var(--muted); }
  .fav { display: grid; place-items: center; }
  .fav svg { width: 100%; height: 100%; display: block; }
  .fav--32 { width: 32px; height: 32px; }
  .fav--16 { width: 16px; height: 16px; }
  @media (max-width: 560px) { .usage__header nav { display: none; } }
  .note { margin-top: 48px; font-size: 13px; color: var(--muted); }

  /* ---------- Слэш ---------- */
  .l-slash { display: inline-flex; align-items: baseline; font: 800 1em/1 'Inter', sans-serif; letter-spacing: -0.025em; white-space: nowrap; }
  .l-slash b { font-weight: 800; color: var(--ultra); }
  .cell--dark .l-slash b { color: var(--lime); }
  .l-slash em { font-style: normal; font-weight: 400; letter-spacing: -0.02em; }
  /* Приглушаем только текст дескриптора, курсор остаётся в полном цвете */
  .l-slash em:not(.typed), .l-slash [data-type] { opacity: 0.55; }
  .anim.l-slash { font-size: clamp(30px, 4.4vw, 48px); }
  .lg.l-slash { font-size: clamp(36px, 5.6vw, 60px); }
  .md.l-slash { font-size: clamp(28px, 4vw, 40px); }
  .sm.l-slash { font-size: 20px; }

  /*
   * Печать. Ширина фиксирована: невидимый «призрак» слова + постоянный отступ под курсор.
   * Курсор позиционирован абсолютно — он не участвует в расчёте ширины,
   * поэтому логотип не растёт при наборе и пункты меню стоят на месте.
   */
  .typed { display: inline-grid; padding-right: 0.56em; }
  .typed > * { grid-area: 1 / 1; }
  .typed__ghost { visibility: hidden; }
  .typed__live { position: relative; justify-self: start; }

  /* Курсор: в цвете слэша, мигает коротко */
  .caret {
    position: absolute; left: 100%; top: 0.08em;
    width: 0.42em; height: 0.8em; margin-left: 0.08em;
    background: var(--ultra); border-radius: 0;
    animation: blink 1.1s infinite;
  }
  .cell--dark .caret { background: var(--lime); }
  @keyframes blink { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0; } }

  /* Шапка: после набора курсор плавно исчезает */
  .caret.caret--off { animation: none; opacity: 0; transition: opacity 0.35s ease; }

  .usage__variants { flex: 1 1 560px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .usage__variants .usage__header { flex: none; }
  .usage__logo { flex: none; }
  .usage__replay { align-self: flex-start; padding: 8px 16px; border: 0; border-radius: 12px; background: #fff; color: var(--muted); font: 500 13px 'Inter', sans-serif; cursor: pointer; }
  .usage__replay:hover { color: var(--ink); }
  .usage__fav { align-self: flex-start; }

  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; }
  }
</style>
