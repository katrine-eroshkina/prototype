---
/**
 * Каталог блоков: 16 блоков и все их варианты на примере страницы услуги + схемы страниц.
 * Основа будущей инструкции по компоновке.
 */
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Block from '../blocks/Block.astro';
import { library, recipes } from '../data/recipes';
import type { PageCtx } from '../data/content';

const sample: PageCtx = {
  kind: 'service',
  title: 'SEO-аудит',
  direction: 'digital',
  category: { slug: 'seo', title: 'SEO-продвижение' },
  children: [{ href: '/uslugi/seo/seo-audit/', title: 'SEO-аудит' }],
  crumbs: [{ href: '/uslugi/', title: 'Услуги' }, { href: '/uslugi/seo/', title: 'SEO-продвижение' }, { title: 'SEO-аудит' }],
};
const key = (b: string, v: string) => (v === 'default' ? b : `${b}:${v}`);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Каталог блоков — прототип</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  </head>
  <body>
    <Header />
    <main>
      <div class="container-x py-10">
        <h1 class="text-4xl font-semibold tracking-tight">Каталог блоков</h1>
        <p class="mt-3 max-w-2xl text-muted-foreground">16 блоков, у части есть варианты. Пример — страница услуги «SEO-аудит»; на реальных страницах тексты подставляются по контексту.</p>

        <h2 class="mt-10 mb-3 text-xl font-semibold">Блоки</h2>
        <ol class="list-decimal columns-1 pl-6 text-sm md:columns-2">
          {library.map((b) => (
            <li class="mb-1 break-inside-avoid">
              <a class="underline" href={`#cat-${b.id}`}><code>{b.id}</code></a> — {b.title}
              {b.variants.length > 1 && <span class="text-muted-foreground"> · {b.variants.map((v) => v.id).join(', ')}</span>}
            </li>
          ))}
        </ol>

        <h2 class="mt-10 mb-3 text-xl font-semibold">Схемы страниц</h2>
        <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
          {Object.entries(recipes).map(([name, list]) => (
            <>
              <dt><code>{name}</code></dt>
              <dd class="font-mono [overflow-wrap:anywhere]">{list.join(' → ')}</dd>
            </>
          ))}
        </dl>
      </div>

      {library.map((b) => (
        <div class="scroll-mt-16 border-t-4 border-foreground" id={`cat-${b.id}`}>
          {b.variants.map((v, i) => (
            <div class="border-b border-dashed">
              <div class="container-x py-3 text-sm">
                <code class="font-bold">{key(b.id, v.id)}</code> <span class="text-muted-foreground">{b.title} · {v.title}</span>
              </div>
              <Block id={key(b.id, v.id)} ctx={sample} index={i} />
            </div>
          ))}
        </div>
      ))}
    </main>
    <Footer />
  </body>
</html>

