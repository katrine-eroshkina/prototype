---
/**
 * Страницы услуг (модель business-up и брифа):
 *   /uslugi/[категория]/          — категория (T2, схема «category»)
 *   /uslugi/[категория]/[услуга]/ — услуга (T3, схема «service»)
 * Каталог /uslugi/ — отдельный файл index.astro.
 */
import Base from '../../layouts/Base.astro';
import { groups, catUrl, serviceUrl } from '../../data/sitemap';
import type { RecipeKey } from '../../data/recipes';
import type { Crumb, PageCtx } from '../../data/content';

type Entry = {
  path: string;
  title: string;
  template: 'listing' | 'detail';
  recipe: RecipeKey;
  crumbs: Crumb[];
  draft?: boolean;
  ctx: Partial<PageCtx>;
};

export function getStaticPaths() {
  const entries: Entry[] = [];
  const root: Crumb = { href: '/uslugi/', title: 'Услуги' };

  for (const g of groups) {
    for (const c of g.categories) {
      const category = { slug: c.slug, title: c.title };
      entries.push({
        path: c.slug,
        title: c.title,
        template: 'listing',
        recipe: 'category',
        crumbs: [root, { title: c.title }],
        draft: c.draft,
        ctx: {
          kind: 'category',
          direction: g.slug,
          category,
          children: c.children.map((s) => ({ href: serviceUrl(c, s), title: s.title, draft: s.draft })),
        },
      });

      for (const s of c.children) {
        entries.push({
          path: `${c.slug}/${s.slug}`,
          title: s.title,
          template: 'detail',
          recipe: 'service',
          crumbs: [root, { href: catUrl(c), title: c.title }, { title: s.title }],
          draft: s.draft,
          ctx: { kind: 'service', direction: g.slug, category },
        });
      }
    }
  }

  return entries.map((entry) => ({ params: { path: entry.path }, props: entry }));
}

const { title, template, recipe, crumbs, draft, ctx } = Astro.props as Entry;
---
<Base {title} {template} {recipe} {crumbs} {draft} {ctx} />
