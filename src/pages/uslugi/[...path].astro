---
/**
 * Все страницы услуг из src/data/sitemap.ts:
 *   /uslugi/konsalting/, /uslugi/digital/           — направление (T2)
 *   /uslugi/strategiya/                             — услуга консалтинга (T3)
 *   /uslugi/seo/                                    — категория digital (T2)
 *   /uslugi/seo/seo-audit/                          — услуга digital (T3)
 * Направление не входит в URL услуг: адреса короче и не меняются при перегруппировке.
 */
import Base from '../../layouts/Base.astro';
import LinkList from '../../components/wire/LinkList.astro';
import { directions } from '../../data/sitemap';
import type { RecipeKey } from '../../data/recipes';

type Crumb = { href?: string; title: string };
type Entry = {
  path: string;
  title: string;
  template: 'listing' | 'detail';
  recipe: RecipeKey;
  crumbs: Crumb[];
  draft?: boolean;
  children?: { href: string; title: string; draft?: boolean }[];
};

export function getStaticPaths() {
  const entries: Entry[] = [];
  const root: Crumb = { href: '/uslugi/', title: 'Услуги' };

  for (const dir of directions) {
    const dirCrumb: Crumb = { href: `/uslugi/${dir.slug}/`, title: dir.title };
    entries.push({
      path: dir.slug,
      title: dir.title,
      template: 'listing',
      recipe: 'direction',
      crumbs: [root, { title: dir.title }],
      children: dir.items.map((i) => ({ href: `/uslugi/${i.slug}/`, title: i.title, draft: i.draft })),
    });

    for (const item of dir.items) {
      const isCategory = Boolean(item.children?.length);
      entries.push({
        path: item.slug,
        title: item.title,
        template: isCategory ? 'listing' : 'detail',
        recipe: isCategory ? 'category' : 'service',
        crumbs: [root, dirCrumb, { title: item.title }],
        draft: item.draft,
        children: item.children?.map((c) => ({ href: `/uslugi/${item.slug}/${c.slug}/`, title: c.title, draft: c.draft })),
      });

      for (const child of item.children ?? []) {
        entries.push({
          path: `${item.slug}/${child.slug}`,
          title: child.title,
          template: 'detail',
          recipe: 'service',
          crumbs: [root, dirCrumb, { href: `/uslugi/${item.slug}/`, title: item.title }, { title: child.title }],
          draft: child.draft,
        });
      }
    }
  }

  return entries.map((entry) => ({ params: { path: entry.path }, props: entry }));
}

const { title, template, recipe, crumbs, draft, children } = Astro.props as Entry;
---
<Base {title} {template} {recipe} {crumbs} {draft}>
  {children && <LinkList items={children} />}
</Base>
